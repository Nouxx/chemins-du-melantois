---
import { getPageTitle, getStructuredDataForPage } from "@data/site/seo";
import VolunteerRolesSection from "@components/functional/volunteer/VolunteerRolesSection.astro";
import MainLayout from "@components/functional/ui/MainLayout.astro";
import VolunteerAppreciationSection from "@components/functional/volunteer/VolunteerAppreciationSection.astro";
import VolunteerCallToActionSection from "@components/functional/volunteer/VolunteerCallToActionSection.astro";

const pageTitle = getPageTitle("Bénévoles");

const pageDescription =
  "Participez à l'organisation de notre course en rejoignant l'équipe de bénévoles ! Votre aide est précieuse pour faire de cet événement un moment chaleureux, solidaire et inoubliable pour tous.";
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={pageTitle}
  structuredData={getStructuredDataForPage(pageDescription)}
>
  <VolunteerAppreciationSection />

  <VolunteerRolesSection />

  <VolunteerCallToActionSection />
</MainLayout>
