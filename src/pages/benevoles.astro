---
import MainLayout from "@/layouts/MainLayout.astro";
import RightSection from "@/components/ui/blocks/RightSection.astro";
import imgVolunteerThree from "@images/races/900m-sem-hero.webp";
import {
  getPageTitle,
  getStructuredDataForPage,
} from "@/utils/structured-data";
import TestimonialsSectionAlt from "@/components/sections/testimonials/TestimonialsSectionAlt.astro";
import HeroSectionAlt from "@/components/sections/landing/HeroSectionAlt.astro";
import PrimaryCTA from "@/components/ui/buttons/PrimaryCTA.astro";
import { SITE } from "@/data_files/constants";

const pageTitle = getPageTitle("Bénévoles");

const testimonials = [
  {
    content:
      "Je suis positionné sur un point du parcours pour indiquer la direction aux coureurs ou sécuriser un carrefour.",
    role: "Signaleur",
    img: imgVolunteerThree,
    imgAlt: "todo",
  },
  {
    content:
      "Je prépare et distribue eau et encas aux coureurs sur les points de ravitaillement.",
    role: "Ravitaillement",
    img: imgVolunteerThree,
    imgAlt: "todo",
  },
  {
    content:
      "J’aide à mettre en place et démonter les équipements : barrières, signalétique, zones de départ et d’arrivée.",
    role: "Installation",
    img: imgVolunteerThree,
    imgAlt: "JP",
  },
  {
    content:
      "Je capture les moments forts de la course : départs, arrivées, sourires, efforts et émotions.",
    role: "Photographe",
    img: imgVolunteerThree,
    imgAlt: "JP",
  },
];

const pageDescription =
  "Participez à l’organisation de notre course en rejoignant l’équipe de bénévoles ! Votre aide est précieuse pour faire de cet événement un moment chaleureux, solidaire et inoubliable pour tous.";
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={pageTitle}
  structuredData={getStructuredDataForPage(pageDescription)}
>
  <RightSection
    title="Cet évènement est possible grâce à vous"
    subTitle="Grâce à votre énergie, votre bonne humeur et votre présence sur le terrain, cet évènement devient bien plus qu’une simple course : c’est un rendez-vous chaleureux, animé par le sourire des bénévoles, où se mêlent entraide, fierté collective et joie de faire vivre notre village. Sans vous, rien de tout cela ne serait possible."
    single={true}
    imgOne={imgVolunteerThree}
    imgOneAlt={"toto"}
  />

  <TestimonialsSectionAlt
    title="Trouvez le rôle qui vous correspond"
    testimonials={testimonials}
  />

  <HeroSectionAlt
    title="Comment devenir bénévole ?"
    subTitle="L'aventure vous tente ? Contactez-nous !"
  >
    <PrimaryCTA
      title={`${SITE.contactEmail}`}
      url={`mailto:${SITE.contactEmail}`}
    />
  </HeroSectionAlt>
</MainLayout>
