---
import RaceBannerSection from "@components/functional/races/RaceBannerSection.astro";
import RaceCardsSection from "@components/functional/races/RaceCardsSection.astro";
import MainLayout from "@components/functional/ui/MainLayout.astro";
import { getPageTitle, getStructuredDataForPage } from "@data/site/seo";
import { t } from "@lib/i18n";

const pageTitle = getPageTitle(t("headerNavigation.races"));

const pageDescription = t("racePage.description");
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={pageTitle}
  structuredData={getStructuredDataForPage(pageDescription)}
>
  <RaceBannerSection />

  <RaceCardsSection />
</MainLayout>
