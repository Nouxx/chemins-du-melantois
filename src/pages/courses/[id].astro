---
import MainLayout from "@/layouts/MainLayout.astro";
import {
  getPageTitle,
  getStructuredDataForPage,
} from "@/utils/structured-data";
import TwoColumnsLayout from "@/components/ui/atoms/TwoColumnsLayout.astro";
import Section from "@/components/ui/atoms/Section.astro";
import RaceMapImage from "@/components/functional/RaceMapImage.astro";
import MobileProgressBar from "@/components/functional/MobileProgressBar.astro";
import RaceTOC from "@/components/functional/RaceTOC.astro";
import RaceRegistrationSection from "@/components/sections/races/Registration/RaceRegistrationSection.astro";
import RaceHeading from "@/components/sections/races/RaceHeading.astro";
import { racesPageData } from "@/data_files/races/races";
import type { RacePageData } from "@/data_files/races/schema";
import RaceRewardsSection from "@/components/sections/races/RaceRewardsSection.astro";
import RaceBibSection from "@/components/sections/races/RaceBibSection.astro";
import RaceRegistrationDetailsSection from "@/components/sections/races/RegistrationDetails/RaceRegistrationDetailsSection.astro";
import RaceRegulationsSection from "@/components/sections/races/RaceRegulationsSection.astro";
import RaceScheduleSection from "@/components/sections/races/RaceScheduleSection.astro";
import RaceDescriptionSection from "@/components/sections/races/RaceDescriptionSection.astro";

export function getStaticPaths() {
  return racesPageData.map((racePageData) => ({
    params: { id: racePageData.urlSlug },
    props: { racePageData },
  }));
}

interface Props {
  racePageData: RacePageData;
}

const { racePageData } = Astro.props;

const pageTitle = getPageTitle(racePageData.pageTitle);
const pageDescription = racePageData.routeSection.description;
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={pageTitle}
  structuredData={getStructuredDataForPage(pageDescription)}
>
  <Section>
    <TwoColumnsLayout>
      <div slot="left">
        <RaceMapImage
          image={racePageData.featuredImage.image}
          alt={racePageData.featuredImage.alt}
        />

        <MobileProgressBar />

        <RaceTOC racePageData={racePageData} />
      </div>

      <div slot="right">
        <article class="flex flex-col gap-14">
          <RaceHeading racePageData={racePageData} />

          <RaceDescriptionSection sectionData={racePageData.routeSection} />

          <RaceScheduleSection sectionData={racePageData.scheduleSection} />

          <RaceRewardsSection sectionData={racePageData.rewardsSection} />

          <RaceRegistrationSection
            sectionData={racePageData.registrationSection}
          />

          <RaceBibSection sectionData={racePageData.bibSection} />

          <RaceRegistrationDetailsSection
            sectionData={racePageData.registrationDetailsSection}
          />

          <RaceRegulationsSection
            sectionData={racePageData.regulationSection}
          />
        </article>
      </div>
    </TwoColumnsLayout>
  </Section>
</MainLayout>

<style is:global>
  :root {
    --transition-cubic: cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    scroll-margin-top: 3rem;
  }
</style>
