---
import TwoColumnsLayout from "@components/ui/atoms/TwoColumnsLayout.astro";
import Section from "@components/ui/atoms/Section.astro";
import { racesPageData } from "@data/races/races";
import type { RacePageData } from "@data/races/schema";
import { getPageTitle, getStructuredDataForPage } from "@data/site/seo";
import RaceMapImage from "@components/functional/races/RaceMapImage.astro";
import MobileProgressBar from "@components/functional/races/MobileProgressBar.astro";
import RacePageContent from "@components/functional/races/RacePageContent.astro";
import RaceTOC from "@components/functional/races/RaceTOC.astro";
import MainLayout from "@components/functional/ui/MainLayout.astro";

export function getStaticPaths() {
  return racesPageData.map((racePageData) => ({
    params: { id: racePageData.urlSlug },
    props: { racePageData },
  }));
}

interface Props {
  racePageData: RacePageData;
}

const { racePageData } = Astro.props;

const pageTitle = getPageTitle(racePageData.pageTitle);
const pageDescription = racePageData.routeSection.description;
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={pageTitle}
  structuredData={getStructuredDataForPage(pageDescription)}
>
  <MobileProgressBar />

  <Section>
    <TwoColumnsLayout>
      <div slot="left">
        <RaceMapImage
          image={racePageData.featuredImage.image}
          alt={racePageData.featuredImage.alt}
        />

        <RaceTOC racePageData={racePageData} />
      </div>

      <div slot="right">
        <RacePageContent data={racePageData} />
      </div>
    </TwoColumnsLayout>
  </Section>
</MainLayout>

<style is:global>
  :root {
    --transition-cubic: cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    scroll-margin-top: 3rem;
  }
</style>
