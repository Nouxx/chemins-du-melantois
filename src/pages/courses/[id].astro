---
import MainLayout from "@/layouts/MainLayout.astro";
import RaceRegulations from "@/components/sections/races/RaceRegulations.astro";
import Registration from "@/components/sections/races/Registration/Registration.astro";
import Schedule from "@/components/sections/races/Schedule.astro";
import Rewards from "@/components/sections/races/Rewards.astro";
import Bib from "@/components/sections/races/Bib.astro";
import RegistrationDetails from "@/components/sections/races/RegistrationDetails/RegistrationDetails.astro";
import {
  getPageTitle,
  getStructuredDataForPage,
} from "@/utils/structured-data";
import { externalLinks, races, type Race } from "@/data_files/constants";
import RaceDescription from "@/components/sections/races/RaceDescription.astro";
import OnlineRegistrationText from "@/components/sections/races/Registration/OnlineRegistrationText.astro";
import OnSiteRegistrationText from "@/components/sections/races/Registration/OnSiteRegistrationText.astro";
import AdultRegistrationText from "@/components/sections/races/RegistrationDetails/AdultRegistrationText.astro";
import NoAdultRegistrationText from "@/components/sections/races/RegistrationDetails/NoAdultRegistrationText.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import TwoColumnsLayout from "@/components/ui/atoms/TwoColumnsLayout.astro";
import Section from "@/components/ui/atoms/Section.astro";
import RaceMapImage from "@/components/functional/RaceMapImage.astro";
import MobileProgressBar from "@/components/functional/MobileProgressBar.astro";
import DesktopProgressBar from "@/components/functional/DesktopProgressBar.astro";
import RaceTOC from "@/components/functional/RaceTOC.astro";

export function getStaticPaths() {
  return races.map((race) => ({
    params: { id: race.id },
    props: { race },
  }));
}

interface Props {
  race: Race;
}

const { race } = Astro.props;

const isFree = !race.price;
const pageTitle = getPageTitle(race.title);
const pageDescription = race.description;
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={pageTitle}
  structuredData={getStructuredDataForPage(pageDescription)}
>
  <Section>
    <TwoColumnsLayout>
      <div slot="left">
        <RaceMapImage image={race.hero.image} alt={race.hero.alt} />

        <MobileProgressBar />

        <div id="pin" class="mt-10 hidden space-y-4 md:block">
          <DesktopProgressBar />

          <RaceTOC />
        </div>
      </div>

      <div slot="right" class="md:pt-8">
        <Heading size="small">{race.title}</Heading>

        <article
          class="race__content text-lg text-pretty text-neutral-700 dark:text-neutral-300"
        >
          <p class="text-xl">
            {race.date} - {
              isFree
                ? "Gratuit"
                : `${race.price}€ par ${race.pricePerTeam ? "équipe" : "participant"}`
            }
          </p>

          <RaceDescription
            text={race.description}
            traceLinkPDF={race.traceLink}
            traceLinkMaps={externalLinks.edition2025.traceMaps}
          />

          <Schedule
            addressLines={race.meetingPointAddressLines}
            additionalInfo={race.additionalScheduleInformation}
            startTime={race.startTime}
          />

          {
            race.rewardsSummary && (
              <Rewards
                text={race.rewardsSummary}
                displayLink={race.displayRewardsSummaryLink}
              />
            )
          }

          <Registration>
            <OnlineRegistrationText
              slot="online-registration-text"
              isRaceFree={isFree}
            />
            <OnSiteRegistrationText slot="on-site-registration-text" />
          </Registration>

          <Bib />

          <RegistrationDetails>
            {
              race.adultRegistrationRequirement ? (
                <AdultRegistrationText slot="adult-registration-text" />
              ) : (
                <NoAdultRegistrationText slot="adult-registration-text" />
              )
            }
          </RegistrationDetails>

          <RaceRegulations />
        </article>
      </div>
    </TwoColumnsLayout>
  </Section>
</MainLayout>

<style is:global>
  :root {
    --transition-cubic: cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    font-weight: bold;
    margin-top: 2.5rem;
    scroll-margin-top: 3rem;
  }

  h2 {
    font-size: 1.5rem;
    line-height: 2rem;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }

  h4 {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  p,
  ul {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  li {
    list-style: disc;
    list-style-position: inside;
  }

  article > ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  #toc li {
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: all 300ms var(--transition-cubic);
  }

  #toc li.selected {
    opacity: 1;
  }

  #toc li svg {
    width: 0;
    height: 0;
    transition:
      height 400ms var(--transition-cubic),
      width 400ms var(--transition-cubic);
  }

  #toc li.selected svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.3rem;
  }
</style>
