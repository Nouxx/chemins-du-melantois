---
import MainLayout from "@/layouts/MainLayout.astro";
import RaceRegulations from "@/components/sections/races/RaceRegulations.astro";
import {
  getPageTitle,
  getStructuredDataForPage,
} from "@/utils/structured-data";
import { races, type Race } from "@/data_files/constants";
import RaceDescription from "@/components/sections/races/RaceDescription.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import TwoColumnsLayout from "@/components/ui/atoms/TwoColumnsLayout.astro";
import Section from "@/components/ui/atoms/Section.astro";
import RaceMapImage from "@/components/functional/RaceMapImage.astro";
import MobileProgressBar from "@/components/functional/MobileProgressBar.astro";
import DesktopProgressBar from "@/components/functional/DesktopProgressBar.astro";
import RaceTOC from "@/components/functional/RaceTOC.astro";
import RaceSchedule from "@/components/sections/races/RaceSchedule.astro";
import RaceRewards from "@/components/sections/races/RaceRewards.astro";
import RaceRegistration from "@/components/sections/races/Registration/RaceRegistration.astro";
import RaceBib from "@/components/sections/races/RaceBib.astro";
import RaceRegistrationDetails from "@/components/sections/races/RegistrationDetails/RaceRegistrationDetails.astro";
import AdultRegistrationNotRequired from "@/components/sections/races/RegistrationDetails/AdultRegistrationNotRequired.astro";
import AdultRegistrationDetails from "@/components/sections/races/RegistrationDetails/AdultRegistrationDetails.astro";
import RaceHeading from "@/components/sections/races/RaceHeading.astro";

export function getStaticPaths() {
  return races.map((race) => ({
    params: { id: race.id },
    props: { race },
  }));
}

interface Props {
  race: Race;
}

const { race } = Astro.props;

const pageTitle = getPageTitle(race.title);
const pageDescription = race.description;
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={pageTitle}
  structuredData={getStructuredDataForPage(pageDescription)}
>
  <Section>
    <TwoColumnsLayout>
      <div slot="left">
        <RaceMapImage image={race.hero.image} alt={race.hero.alt} />

        <MobileProgressBar />

        <div id="pin" class="mt-10 hidden space-y-4 md:block">
          <DesktopProgressBar />

          <RaceTOC race={race} />
        </div>
      </div>

      <div slot="right">
        <article class="flex flex-col gap-14">
          <RaceHeading race={race} />

          <RaceDescription race={race} />

          <RaceSchedule race={race} />

          {race.rewardsSummary && <RaceRewards race={race} />}

          <RaceRegistration race={race} />

          <RaceBib />

          <RaceRegistrationDetails>
            {
              race.adultRegistrationRequirement ? (
                <AdultRegistrationDetails slot="adult-registration-text" />
              ) : (
                <AdultRegistrationNotRequired slot="adult-registration-text" />
              )
            }
          </RaceRegistrationDetails>

          <RaceRegulations />
        </article>
      </div>
    </TwoColumnsLayout>
  </Section>
</MainLayout>

<style is:global>
  :root {
    --transition-cubic: cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    scroll-margin-top: 3rem;
  }

  li {
    list-style: disc;
    list-style-position: inside;
  }

  #toc li {
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: all 300ms var(--transition-cubic);
  }

  #toc li.selected {
    opacity: 1;
  }

  #toc li svg {
    width: 0;
    height: 0;
    transition:
      height 400ms var(--transition-cubic),
      width 400ms var(--transition-cubic);
  }

  #toc li.selected svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.3rem;
  }
</style>
