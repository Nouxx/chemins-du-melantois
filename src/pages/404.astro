---
import Heading from "@components/ui/atoms/Heading.astro";
import { routes } from "@data/navigation/routes/routes";
import { getPageTitle } from "@data/site/seo";
import Body from "@components/ui/atoms/Body.astro";
import Section from "@components/ui/atoms/Section.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import MainLayout from "@components/functional/ui/MainLayout.astro";
import LinkButton from "@components/ui/atoms/LinkButton.astro";

const pageTitle = getPageTitle("Page Introuvable");
---

<MainLayout title={pageTitle}>
  <Section className="h-svh place-content-center text-center">
    <Flex direction="col" items="center" justify="center" gap={8}>
      <Heading tag="h1">Page Introuvable</Heading>
      <Body>Oups, cette portion du parcours n'existe pas !</Body>
      <Body
        >Pas de panique, même les meilleurs peuvent faire un petit détour.</Body
      >
      <LinkButton label="Retour vers l'accueil" url={routes.home} />
    </Flex>
  </Section>
</MainLayout>
