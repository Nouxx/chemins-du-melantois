---
import Image from "astro/components/Image.astro";

const { title, subTitle, testimonials } = Astro.props;

interface Testimonial {
  content: string;
  role: string;
  avatarSrc?: string;
  avatarAlt?: string;
  img: any;
  imgAlt: string;
}

interface Props {
  title: string;
  subTitle: string;
  testimonials: Testimonial[];
}
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  id="testimonials"
>
  <div class="full-width mb-8 text-left">
    <h2
      class="mb-4 text-left text-2xl font-extrabold text-balance text-neutral-800 sm:text-3xl lg:text-4xl dark:text-neutral-200"
    >
      {title}
    </h2>

    <p
      class="mb-4 max-w-prose font-normal text-pretty text-neutral-600 sm:text-lg dark:text-neutral-400"
    >
      {subTitle}
    </p>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      testimonials.map((testimonial) => (
        <div class="flex h-auto">
          <div class="flex flex-col rounded-xl bg-neutral-50 dark:bg-neutral-700">
            <div class="flex-auto gap-4">
              <Image
                class="w-full rounded-t-lg"
                src={testimonial.img}
                alt={testimonial.imgAlt}
                format={"avif"}
                sizes="(max-width: 640px) 100vw, (max-width: 1536px) 50vw, 642px"
              />
            </div>

            <div class="h-full rounded-b-xl bg-neutral-300/30 p-4 md:px-7 dark:bg-neutral-900/30">
              <div class="flex">
                <div class="grow">
                  <p class="text-sm font-bold text-neutral-800 sm:text-base dark:text-neutral-200">
                    {testimonial.role}
                  </p>
                  <p class="text-s text-neutral-600 dark:text-neutral-400">
                    {testimonial.content}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
