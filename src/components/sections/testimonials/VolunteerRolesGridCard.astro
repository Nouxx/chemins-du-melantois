---
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import ImageWrapper from "@/components/ui/atoms/ImageWrapper.astro";
import type { VolunteerRoleData } from "@/data_files/volunteers/schema";

interface Props {
  volunteerRoleData: VolunteerRoleData;
}

const { role, content, roleImage } = Astro.props.volunteerRoleData;
---

<div class="flex h-auto">
  <div class="flex flex-col rounded-xl bg-neutral-50 dark:bg-neutral-700">
    <div class="flex-auto gap-4">
      <ImageWrapper
        image={roleImage.image}
        imageAlt={roleImage.alt}
        sizes="(max-width: 640px) 100vw, (max-width: 1536px) 50vw, 642px"
        className="rounded-t-lg"
      />
    </div>

    <div
      class="h-full rounded-b-lg bg-neutral-300/30 p-4 md:px-7 dark:bg-neutral-900/30"
    >
      <div class="flex">
        <div class="flex grow flex-col gap-2">
          <Heading size="xsmall">{role}</Heading>
          <Body size="small">{content}</Body>
        </div>
      </div>
    </div>
  </div>
</div>
