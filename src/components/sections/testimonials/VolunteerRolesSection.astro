---
import VolunteerRolesGridCard from "@/components/sections/testimonials/VolunteerRolesGridCard.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Flex from "@/components/ui/atoms/Flex.astro";
import Grid from "@/components/ui/atoms/Grid.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import Section from "@/components/ui/atoms/Section.astro";
import { volunteerRolesData } from "@/data_files/volunteers/roles";
---

<Section>
  <Flex direction="col" gap={8}>
    <Flex direction="col" gap={4}>
      <Heading size="medium">Trouvez le rôle qui vous correspond</Heading>

      <Body>
        Découvrez les différentes missions et choisissez celle qui vous
        ressemble. Chaque geste compte pour faire de cet évènement un moment
        inoubliable.
      </Body>
    </Flex>

    <Grid gap={8} className="sm:grid-cols-2">
      {
        volunteerRolesData.map((volunteerRoleData) => (
          <VolunteerRolesGridCard volunteerRoleData={volunteerRoleData} />
        ))
      }
    </Grid>
  </Flex>
</Section>
