---
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import type { RacePageData } from "@/data_files/races/schema";

interface Props {
  data: RacePageData;
}

const { data } = Astro.props;
---

<RaceDetailSection>
  <Heading size="medium">{data.pageTitle}</Heading>

  <Body>
    {data.date} - {data.price}
  </Body>
</RaceDetailSection>
