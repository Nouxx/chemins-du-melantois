---
import Heading from "@/components/ui/atoms/Heading.astro";
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import type { RacePageData } from "@/data_files/races/schema";
import OnSiteRaceRegistration from "@/components/sections/races/Registration/OnSiteRaceRegistration.astro";
import OnlineRaceRegistration from "@/components/sections/races/Registration/OnlineRaceRegistration.astro";

interface Props {
  data: RacePageData["registrationSection"];
}

const { title, anchorId, onSiteRegistration, onlineRegistration } =
  Astro.props.data;
---

<RaceDetailSection gap={8}>
  <Heading size="small" id={anchorId} tag="h2">{title}</Heading>

  <OnlineRaceRegistration data={onlineRegistration} />

  <OnSiteRaceRegistration data={onSiteRegistration} />
</RaceDetailSection>
