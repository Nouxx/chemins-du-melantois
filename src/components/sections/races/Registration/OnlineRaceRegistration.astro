---
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import type { RacePageData } from "@/data_files/races/schema";

interface Props {
  sectionData: RacePageData["registrationSection"]["onlineRegistration"];
}

const { title, description, additionalDescription, link } =
  Astro.props.sectionData;
---

<RaceDetailSection>
  <Heading size="xsmall" tag="h3">
    {title}
  </Heading>

  <Body size="small">
    {description}
  </Body>

  {additionalDescription && <Body size="small">{additionalDescription}</Body>}

  <TextLink href={link.url}>
    {link.label}
  </TextLink>
</RaceDetailSection>
