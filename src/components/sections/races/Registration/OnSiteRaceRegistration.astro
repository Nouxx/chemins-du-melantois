---
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import { registrationDetailsId } from "@/data_files/races/races";
import type { RacePageData } from "@/data_files/races/schema";

interface Props {
  data: RacePageData["registrationSection"]["onSiteRegistration"];
}

const { title, registrationFormLink } = Astro.props.data;
---

<RaceDetailSection>
  <Heading size="xsmall" tag="h3">
    {title}
  </Heading>

  <Body size="small">
    Vous pouvez également vous inscrire à la Maison des Associations de Sainghin
    en Mélantois le samedi 20 septembre, de 14h00 à 17h00. Veillez à venir muni
    de votre bulletin d'inscription rempli ainsi que tous les documents requis
    pour finaliser votre inscription (voir les
    <a class="link__text font-bold" href={`#${registrationDetailsId}`}>
      Modalités d'inscriptions
    </a>
    plus bas).
  </Body>

  <TextLink href={registrationFormLink.url}>
    {registrationFormLink.label}
  </TextLink>
</RaceDetailSection>

<style>
  .link__text:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
