---
import TextLink from "@/components/ui/race/TextLink.astro";
import { externalLinks } from "@/data_files/constants";

interface Props {
  isRaceFree?: boolean;
}

const { isRaceFree } = Astro.props;
---

<p>
  Les inscriptions en ligne sont ouvertes jusqu'au samedi 20 septembre à 12h00
  via notre plateforme partenaire
  <span class="font-bold italic">Miles Republic</span>.
  {
    !isRaceFree &&
      "Le paiement s'effectue également sur cette plateforme."
  }
</p>

<TextLink
  label="Lien vers l'inscription en ligne"
  href={externalLinks.registration}
/>
