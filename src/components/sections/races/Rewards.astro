---
import Heading from "@/components/ui/atoms/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import { externalLinks } from "@/data_files/constants";

interface Props {
  text: string;
  displayLink?: boolean;
}

const { text, displayLink = true } = Astro.props;
---

<Heading>Récompenses</Heading>

<p>{text}</p>

{
  displayLink && (
    <TextLink
      label="Lien vers le tableau des récompenses"
      href={externalLinks.rewardsSummary}
    />
  )
}
