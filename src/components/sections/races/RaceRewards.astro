---
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import { externalLinks, type Race } from "@/data_files/constants";

interface Props {
  race: Race;
}

const { race } = Astro.props;

const { rewardsSummary, displayRewardsSummaryLink = true } = race;
---

<Heading size="small" id="recompenses" tag="h2">Récompenses</Heading>

<Body size="small">{rewardsSummary}</Body>

{
  displayRewardsSummaryLink && (
    <TextLink href={externalLinks.rewardsSummary}>
      Lien vers le tableau des récompenses
    </TextLink>
  )
}
