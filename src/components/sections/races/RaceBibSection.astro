---
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import List from "@/components/ui/molecules/List.astro";
import ListItem from "@/components/ui/molecules/ListItem.astro";
import type { RacePageData } from "@/data/races/schema";

interface Props {
  data: RacePageData["bibSection"];
}

const { title, anchorId, description, pickupScheduleLines } = Astro.props.data;
---

<RaceDetailSection>
  <Heading size="small" tag="h2" id={anchorId}>
    {title}
  </Heading>

  <Body size="small">
    {description}
  </Body>

  <List>
    {
      pickupScheduleLines.map((scheduleLine) => (
        <ListItem>{scheduleLine}</ListItem>
      ))
    }
  </List>
</RaceDetailSection>
