---
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import type { RacePageData } from "@/data_files/races/schema";

interface Props {
  racePageData: RacePageData;
}

const { racePageData } = Astro.props;
---

<RaceDetailSection>
  <Heading size="medium">{racePageData.pageTitle}</Heading>

  <Body>
    {racePageData.date} - {racePageData.price}
  </Body>
</RaceDetailSection>
