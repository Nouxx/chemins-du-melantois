---
import CardSmall from "@/components/ui/cards/CardSmall.astro";
import CardWide from "@/components/ui/cards/CardWide.astro";
import { routes, type Race } from "@/data_files/constants";

interface Props {
  race: Race;
  size: "small" | "wide";
}

const { race, size } = Astro.props;

const url = routes.raceDetails(race.id);
---

{
  size === "small" && (
    <CardSmall
      title={race.title}
      url={url}
      image={race.hero.image}
      imageAlt={race.hero.alt}
    />
  )
}

{
  size === "wide" && (
    <CardWide
      title={race.title}
      url={url}
      image={race.hero.image}
      imageAlt={race.hero.alt}
    />
  )
}
