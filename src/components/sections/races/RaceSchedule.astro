---
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import { eventDate, type Race } from "@/data_files/constants";
import { findSectionById } from "@/utils/findSectionById";

interface Props {
  race: Race;
}

const { race } = Astro.props;

const { meetingPointAddressLines, additionalScheduleInformation, startTime } =
  race;

const section = findSectionById(race, "schedule");
---

<Heading id={section.anchorId} tag="h2">{section.title}</Heading>

<Body size="small">
  La course a lieu le <span class="font-bold">{eventDate}</span> et le départ sera
  lancé à <span class="font-bold">{startTime}</span>.
</Body>

<p>Le point de rendez-vous est le suivant :</p>

<div class="address">
  {meetingPointAddressLines.map((addressLine) => <p>{addressLine}</p>)}
</div>

{additionalScheduleInformation && <p>{additionalScheduleInformation}</p>}

<style>
  .address {
    margin-top: 1.5rem;
    p {
      margin-top: 0;
      margin-bottom: 0;
    }

    p:first-child {
      font-weight: bold;
    }
  }
</style>
