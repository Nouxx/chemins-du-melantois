---
import Body from "@/components/ui/atoms/Body.astro";
import List from "@/components/ui/molecules/List.astro";
import ListItem from "@/components/ui/molecules/ListItem.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import { externalLinks } from "@/data_files/constants";
---

<Body size="small">
  Pour valider votre inscription, vous devez fournir l'un des deux documents
  suivants :
</Body>

<List>
  <ListItem>Une Licence conforme et en cours de validité</ListItem>
  <ListItem>
    Un PPS (Parcours Prévention Santé), déclaration remplaçant le certificat
    médical pour les non licenciés.
  </ListItem>
</List>

<TextLink href={externalLinks.pps}>En savoir plus sur le PPS</TextLink>
