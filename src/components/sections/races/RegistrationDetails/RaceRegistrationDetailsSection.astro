---
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import AdultRegistrationDetailsSection from "@/components/sections/races/RegistrationDetails/AdultRegistrationDetailsSection.astro";
import ChildrenRegistrationDetailsSection from "@/components/sections/races/RegistrationDetails/ChildrenRegistrationDetailsSection.astro";
import Heading from "@/components/ui/atoms/Heading.astro";

import type { RacePageData } from "@/data/races/schema";

interface Props {
  data: RacePageData["registrationDetailsSection"];
}

const { title, anchorId, forAdults, forChildren } = Astro.props.data;
---

<RaceDetailSection gap={8}>
  <Heading size="small" id={anchorId} tag="h2">
    {title}
  </Heading>

  <AdultRegistrationDetailsSection data={forAdults} />

  <ChildrenRegistrationDetailsSection data={forChildren} />
</RaceDetailSection>
