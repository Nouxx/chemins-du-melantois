---
import Heading from "@/components/ui/race/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import { externalLinks, registrationDetailsId } from "@/data_files/constants";
---

<Heading label="Modalités d'inscription" id={registrationDetailsId} />

<Heading tag="h3" label="Pour les majeurs" />

<slot name="adult-registration-text" />

<Heading tag="h3" label="Pour les mineurs" />

<p>
  Les participants de moins de 18 ans doivent impérativement fournir les 2
  documents suivants :
</p>

<ul>
  <li>Une autorisation parentale signée</li>
  <li>
    Un questionnaire de santé <span class="font-bold">ou</span> un certificat médical
    de moins de 6 mois
  </li>
</ul>

<TextLink
  label="Lien vers l'autorisation parentale"
  href={externalLinks.parentalConsentForm}
/>
<TextLink
  label="Lien vers le questionnaire de santé"
  href={externalLinks.healthQuestionnaire}
/>
