---
import RaceDetailSection from "@/components/sections/races/RaceDetailSection.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import { externalLinks, registrationDetailsId } from "@/data_files/constants";
---

<RaceDetailSection gap={8}>
  <Heading size="small" id={registrationDetailsId} tag="h2">
    Modalités d'inscription
  </Heading>

  <RaceDetailSection>
    <Heading size="xsmall" tag="h3">Pour les majeurs</Heading>

    <slot name="adult-registration-text" />
  </RaceDetailSection>

  <RaceDetailSection>
    <Heading size="xsmall" tag="h3">Pour les mineurs</Heading>

    <Body size="small">
      Les participants de moins de 18 ans doivent impérativement fournir les 2
      documents suivants :
    </Body>

    <ul>
      <Body tag="li" size="small">Une autorisation parentale signée</Body>
      <Body tag="li" size="small">
        Un questionnaire de santé <span class="font-bold">ou</span> un certificat
        médical de moins de 6 mois
      </Body>
    </ul>

    <TextLink href={externalLinks.parentalConsentForm}>
      Lien vers l'autorisation parentale
    </TextLink>

    <TextLink href={externalLinks.healthQuestionnaire}>
      Lien vers le questionnaire de santé
    </TextLink>
  </RaceDetailSection>
</RaceDetailSection>
