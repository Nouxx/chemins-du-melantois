---
import Heading from "@/components/ui/atoms/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";

interface Props {
  text: string;
  traceLinkPDF: string;
  traceLinkMaps: string;
}

const { text, traceLinkPDF, traceLinkMaps } = Astro.props;
---

<Heading id="parcours" tag="h2">Parcours</Heading>

<p>{text}</p>

<TextLink label="Lien vers le tracé (PDF)" href={traceLinkPDF} />

<TextLink
  label="Lien vers les tracés interactifs (Maps)"
  href={traceLinkMaps}
/>
