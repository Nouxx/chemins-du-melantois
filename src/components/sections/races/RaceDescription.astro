---
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";
import { externalLinks, type Race } from "@/data_files/constants";
import { findSectionById } from "@/utils/findSectionById";

interface Props {
  race: Race;
}

const { race } = Astro.props;
const { description, traceLink } = race;

const section = findSectionById(race, "description");
---

<Heading tag="h2" id={section.anchorId}>{section.title}</Heading>

<Body size="small">{description}</Body>

<TextLink href={traceLink}>Lien vers le tracé (PDF)</TextLink>

<TextLink href={externalLinks.edition2025.traceMaps}>
  Lien vers les tracés interactifs (Maps)
</TextLink>
