---
import Heading from "@/components/ui/race/Heading.astro";
import TextLink from "@/components/ui/race/TextLink.astro";

interface Props {
  text: string;
  traceLinkPDF: string;
  traceLinkMaps: string;
}

const { text, traceLinkPDF, traceLinkMaps } = Astro.props;
---

<Heading label="Parcours" />

<p>{text}</p>

<TextLink label="Lien vers le tracé (PDF)" href={traceLinkPDF} />

<TextLink label="Lien vers les tracé interactif (Maps)" href={traceLinkMaps} />
