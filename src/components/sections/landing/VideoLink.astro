---
import { Image } from "astro:assets";

import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  videoUrl: string;
  image: ImageMetadata;
}

const { title, videoUrl, image } = Astro.props;

const imageClass =
  "h-full w-full object-cover object-center transition duration-[600ms] ease-[cubic-bezier(0.45,0,0.55,1)] group-hover:scale-110";
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <h2
    class="mb-8 text-center text-2xl leading-tight font-bold text-balance text-neutral-800 sm:text-3xl dark:text-neutral-200"
  >
    {title}
  </h2>

  <div
    class="group relative mx-auto w-full max-w-2xl overflow-hidden rounded-lg"
  >
    <a href={videoUrl} target="_blank">
      <Image
        src={image}
        alt={"imageAlt"}
        draggable={"false"}
        class={imageClass}
        format={"avif"}
        style={{
          height: "100%",
        }}
      />

      <div
        class="absolute inset-0 flex items-center justify-center bg-black/40 transition-colors group-hover:bg-black/60"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-20 w-20 transform text-white transition-transform group-hover:scale-110"
        >
          <path
            fill-rule="evenodd"
            d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.647c1.295.742 1.295 2.545 0 3.286L7.279 20.99c-1.25.717-2.779-.217-2.779-1.643V5.653z"
            clip-rule="evenodd"></path>
        </svg>
      </div>
    </a>
  </div>
</section>
