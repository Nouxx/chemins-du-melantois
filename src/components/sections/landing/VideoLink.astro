---
import { Image } from "astro:assets";

import Icon from "@/components/ui/icons/Icon.astro";
import Section from "@/components/ui/atoms/Section.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import { externalLinks } from "@/data_files/constants";
import videoPreviewImage from "@images/video-preview.webp";

const imageClass =
  "h-full w-full object-cover object-center transition duration-[600ms] ease-[cubic-bezier(0.45,0,0.55,1)] group-hover:scale-110";
---

<Section>
  <Heading size="medium" classNames="text-center mb-8">
    Retour en images sur l'édition 2024 !
  </Heading>

  <div
    class="group relative mx-auto w-full max-w-2xl overflow-hidden rounded-lg"
  >
    <a href={externalLinks.edition2024.youtubeVideo} target="_blank">
      <Image
        src={videoPreviewImage}
        alt={"imageAlt"}
        draggable={"false"}
        class={imageClass}
        format={"avif"}
        style={{
          height: "100%",
        }}
      />

      <div
        class="absolute inset-0 flex items-center justify-center bg-black/40 transition-colors group-hover:bg-black/60"
      >
        <Icon
          name="play"
          fill="white"
          className="h-18 w-18 transform text-white transition-transform group-hover:scale-110"
        />
      </div>
    </a>
  </div>
</Section>
