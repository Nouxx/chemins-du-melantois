---
import { Image } from "astro:assets";
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import RegisterButton from "@/components/ui/buttons/RegisterButton.astro";

const { subTitle, secondaryBtn, secondaryBtnURL, src, alt } = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  primaryBtnOpenInNewTab?: boolean;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  withReview?: boolean;
  avatars?: Array<string>;
  starCount?: number;
  rating?: string;
  reviews?: string;
  src: any;
  alt: string;
}
---

<section
  class="mx-auto flex max-w-[85rem] flex-col items-stretch gap-4 px-4 py-14 sm:px-6 md:flex-row md:gap-8 lg:px-8 2xl:max-w-full"
>
  <div class="md:max-w-[50%]">
    <h1
      class="text-3xl font-bold tracking-tight text-balance text-neutral-800 sm:text-4xl lg:text-6xl lg:leading-tight dark:text-neutral-200"
    >
      <slot name="title" />
    </h1>
    {
      subTitle && (
        <p class="mt-3 text-lg leading-relaxed text-pretty text-neutral-700 lg:w-4/5 dark:text-neutral-400">
          {subTitle}
        </p>
      )
    }
    <div class="mt-7 grid w-full gap-3 md:inline-flex">
      {
        secondaryBtn && (
          <SecondaryCTA title={secondaryBtn} url={secondaryBtnURL} />
        )
      }
    </div>
  </div>
  <div class="image__placeholder w-full overflow-hidden rounded-md">
    {
      (
        <Image
          src={src}
          alt={alt}
          class="w-full scale-110 object-cover object-center"
          draggable={"false"}
          format={"avif"}
          style={{
            height: "100%",
          }}
          sizes="(max-width: 640px) 100vw, (max-width: 1536px) 50vw, 438px"
        />
      )
    }
  </div>
</section>
