---
import Section from "@/components/ui/atoms/Section.astro";
import FeaturedLogos from "@/components/ui/organism/FeaturedLogos.astro";
import { sponsorsData, type Sponsor } from "@/data_files/sponsors";
import type { SvgLogoLink } from "@/data_files/types";

function adaptPartner(partner: Sponsor): SvgLogoLink {
  return {
    link: {
      href: partner.href,
      name: partner.name,
      openInNewTab: true,
    },
    svg: partner.icon,
  };
}

const adaptedSponsors = sponsorsData.map((sponsor) => adaptPartner(sponsor));
---

<Section>
  <FeaturedLogos
    title="Un grand merci à nos partenaires"
    logoLinks={adaptedSponsors}
  />
</Section>
