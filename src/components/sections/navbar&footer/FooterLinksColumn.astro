---
import FooterLink from "@/components/sections/navbar&footer/FooterLink.astro";
import Flex from "@/components/ui/atoms/Flex.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import type { ButtonLink } from "@/components/ui/types";

interface Props {
  title: string;
  links: ButtonLink[];
}

const { title, links } = Astro.props;
---

<Flex direction="col" gap={4} className="col-span-1">
  <Heading size="xsmall">{title}</Heading>

  <Flex renderAs="ul" direction="col" gap={4}>
    {
      links.map((link) => (
        <FooterLink
          name={link.title}
          url={link.url}
          openInNewTab={link.openInNewTab}
        />
      ))
    }
  </Flex>
</Flex>
