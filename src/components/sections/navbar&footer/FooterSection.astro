---
import FooterSocialLink from "@components/ui/links/FooterSocialLink.astro";
import frStrings from "@/utils/navigation";
import Icon from "@components/ui/icons/Icon.astro";
import BrandLogo from "@components/BrandLogo.astro";
import { externalLinks, routes, SITE } from "@data/constants";
import Section from "@/components/ui/atoms/Section.astro";
import Grid from "@/components/ui/atoms/Grid.astro";

import FooterLinksColumn from "@/components/sections/navbar&footer/FooterLinksColumn.astro";
import Flex from "@/components/ui/atoms/Flex.astro";
import Body from "@/components/ui/atoms/Body.astro";
---

<footer class="w-full bg-neutral-300">
  <Section
    py={10}
    className="sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)"
  >
    <Grid gap={6} className="grid-cols-1 sm:grid-cols-3">
      <div class="col-span-full sm:col-span-1">
        <BrandLogo class="h-auto w-32" />
      </div>

      <FooterLinksColumn
        title="Liens rapides"
        links={[
          {
            title: "Bulletin d'inscription",
            url: externalLinks.registrationForm,
          },
          {
            title: "Liste des inscrits 2025",
            url: externalLinks.registrantsList,
          },
          {
            title: "PPS",
            url: externalLinks.pps,
          },
        ]}
      />

      <FooterLinksColumn
        title="Nous contacter"
        links={[
          {
            title: "Par email",
            url: `mailto:${SITE.contactEmail}`,
          },
          {
            title: "Devenir bénévole",
            url: routes.volunteer,
            openInNewTab: false,
          },
        ]}
      />
    </Grid>

    <Grid
      className="mt-9 gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      <Flex direction="row" items="center" justify="between">
        <Body size="xsmall">
          © 2025 {SITE.title}.
        </Body>
      </Flex>

      <div>
        <FooterSocialLink
          url={externalLinks.facebook}
          ariaLabel="Lien vers Facebook"
        >
          <Icon name="facebook" size="small" />
        </FooterSocialLink>

        <FooterSocialLink
          url={externalLinks.instagram}
          ariaLabel="Lien vers Instagram"
        >
          <Icon name="instagram" size="small" />
        </FooterSocialLink>
      </div>
    </Grid>
  </Section>
</footer>
