---
import PrimaryCTA from "@/components/functional/PrimaryCTA.astro";
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import CTASection from "@/components/ui/molecules/CTASection.astro";
import { SITE } from "@/data_files/constants";
---

<CTASection>
  <Heading slot="heading">Comment devenir bénévole ?</Heading>
  <Body slot="subTitle">L'aventure vous tente ? Contactez-nous !</Body>
  <PrimaryCTA
    slot="button"
    label={`${SITE.contactEmail}`}
    url={`mailto:${SITE.contactEmail}`}
  />
</CTASection>
