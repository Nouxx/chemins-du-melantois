---
import RaceDetailSection from "@components/functional/races/RaceDetailSection.astro";
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import TextLink from "@components/ui/molecules/TextLink.astro";
import type { RacePageData } from "@data/races/schema";
import Translation from "@components/ui/atoms/Translation.astro";
import { t } from "@lib/i18n";

interface Props {
  data: RacePageData["registrationSection"]["onSiteRegistration"];
}

const { title, description, registrationFormLink } = Astro.props.data;
---

<RaceDetailSection>
  <Heading size="xsmall" tag="h3">
    {title}
  </Heading>

  <Text size="medium">
    <Translation input={description} />
  </Text>

  <TextLink url={registrationFormLink.url}>
    {registrationFormLink.label}
  </TextLink>
</RaceDetailSection>

<!-- // todo check -->
<style>
  .link__text:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
