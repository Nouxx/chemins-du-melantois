---
import RaceDetailSection from "@components/functional/races/RaceDetailSection.astro";
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import TextLink from "@components/ui/molecules/TextLink.astro";
import type { RacePageData } from "@data/races/schema";
import Translation from "@components/ui/atoms/Translation.astro";

interface Props {
  data: RacePageData["registrationSection"]["onlineRegistration"];
}

const { title, description, additionalDescription, link } = Astro.props.data;
---

<RaceDetailSection>
  <Heading size="xsmall" tag="h3">
    {title}
  </Heading>

  <Text size="medium">
    <Translation input={description} />
  </Text>

  {additionalDescription && <Text size="medium">{additionalDescription}</Text>}

  <TextLink url={link.url}>
    {link.label}
  </TextLink>
</RaceDetailSection>
