---
import RaceDetailSection from "@components/functional/races/RaceDetailSection.astro";
import OnlineRaceRegistration from "@components/functional/races/registration/OnlineRaceRegistration.astro";
import OnSiteRaceRegistration from "@components/functional/races/registration/OnSiteRaceRegistration.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import type { RacePageData } from "@data/races/schema";

interface Props {
  data: RacePageData["registrationSection"];
}

const { title, anchorId, onSiteRegistration, onlineRegistration } =
  Astro.props.data;
---

<RaceDetailSection gap={8}>
  <Heading size="small" id={anchorId} tag="h2">{title}</Heading>

  <OnlineRaceRegistration data={onlineRegistration} />

  <OnSiteRaceRegistration data={onSiteRegistration} />
</RaceDetailSection>
