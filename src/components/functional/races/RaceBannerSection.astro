---
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Section from "@components/ui/atoms/Section.astro";
import CTABanner from "@components/ui/molecules/CTABanner.astro";
import { t2 } from "@lib/i18n";
---

<Section>
  <CTABanner>
    <Heading slot="heading" size="medium" className="whitespace-nowrap">
      {t2("racePage.banner.title")}
    </Heading>
    <Text slot="subTitle">
      {t2("racePage.banner.message")}
    </Text>
  </CTABanner>
</Section>
