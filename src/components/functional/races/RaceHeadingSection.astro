---
import RaceDetailSection from "@components/functional/races/RaceDetailSection.astro";
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import type { RacePageData } from "@data/races/schema";

interface Props {
  data: RacePageData;
}

const { data } = Astro.props;
---

<RaceDetailSection>
  <Heading size="medium">{data.pageTitle}</Heading>

  <Text>
    {data.date} - {data.price}
  </Text>
</RaceDetailSection>
