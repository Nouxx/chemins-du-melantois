---
import RaceDetailSection from "@components/functional/races/RaceDetailSection.astro";
import Body from "@components/ui/atoms/Body.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import TextLink from "@components/ui/molecules/TextLink.astro";
import type { RacePageData } from "@data/races/schema";

interface Props {
  data: RacePageData["routeSection"];
}

const { title, anchorId, description, tracePDFLink, traceMapsLink } =
  Astro.props.data;
---

<RaceDetailSection>
  <Heading size="small" tag="h2" id={anchorId}>
    {title}
  </Heading>

  <Body size="small">{description}</Body>

  <TextLink url={tracePDFLink.url}>{tracePDFLink.label}</TextLink>

  <TextLink url={traceMapsLink.url}>{traceMapsLink.label}</TextLink>
</RaceDetailSection>
