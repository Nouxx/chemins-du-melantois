---
import { gapVariants } from "@components/ui/props/gap";
import { cva, type VariantProps } from "class-variance-authority";

const raceDetailSection = cva(["flex", "flex-col"], {
  variants: {
    gap: gapVariants,
  },
  defaultVariants: {
    gap: 4,
  },
});

type Variants = VariantProps<typeof raceDetailSection>;

interface Props extends Variants {}

const { gap } = Astro.props;
---

<section class={raceDetailSection({ gap })}>
  <slot />
</section>
