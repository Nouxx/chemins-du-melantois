---
import RaceDetailSection from "@components/functional/races/RaceDetailSection.astro";
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import type { RacePageData } from "@data/races/schema";

interface Props {
  data: RacePageData["scheduleSection"];
}

const {
  title,
  anchorId,
  eventDate,
  startTime,
  meetingPointAddressLines,
  additionalScheduleInformation,
} = Astro.props.data;
---

<RaceDetailSection>
  <Heading size="small" id={anchorId} tag="h2">{title}</Heading>

  <Text size="medium">
    La course a lieu le
    <span class="font-bold">{eventDate}</span>
    et le départ sera lancé à
    <span class="font-bold">{startTime}</span>
    .
  </Text>

  <Text size="medium">Le point de rendez-vous est le suivant :</Text>

  <div class="address">
    {
      meetingPointAddressLines.map((addressLine, index) => (
        <Text
          size="medium"
          className="my-0"
          fontStyle={index === 0 ? "bold" : "normal"}
        >
          {addressLine}
        </Text>
      ))
    }
  </div>

  {
    additionalScheduleInformation && (
      <Text size="medium">{additionalScheduleInformation}</Text>
    )
  }
</RaceDetailSection>
