---
import RaceDetailSection from "@components/functional/races/RaceDetailSection.astro";
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import TextLink from "@components/ui/molecules/TextLink.astro";
import type { RacePageData } from "@data/races/schema";
import { registrationDetailsSectionAnchor } from "@data/races/sections";

interface Props {
  data: RacePageData["registrationSection"]["onSiteRegistration"];
}

const { title, registrationFormLink } = Astro.props.data;
---

<RaceDetailSection>
  <Heading size="xsmall" tag="h3">
    {title}
  </Heading>

  <Text size="medium">
    Vous pouvez également vous inscrire à la Maison des Associations de Sainghin
    en Mélantois le samedi 20 septembre, de 14h00 à 17h00. Veillez à venir muni
    de votre bulletin d'inscription rempli ainsi que tous les documents requis
    pour finaliser votre inscription (voir les
    <a
      class="link__text font-bold"
      href={`#${registrationDetailsSectionAnchor}`}
    >
      Modalités d'inscriptions
    </a>
    plus bas).
  </Text>

  <TextLink url={registrationFormLink.url}>
    {registrationFormLink.label}
  </TextLink>
</RaceDetailSection>

<style>
  .link__text:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
