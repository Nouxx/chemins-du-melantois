---
import CardSmall from "@/components/ui/cards/CardSmall.astro";
import CardWide from "@/components/ui/cards/CardWide.astro";
import { routes } from "@/data_files/constants";
import type { RacePageData } from "@/data_files/races/schema";

interface Props {
  racePageData: RacePageData;
  size: "small" | "wide";
}

const { racePageData: race, size } = Astro.props;

const url = routes.raceDetails(race.urlSlug);
---

{
  size === "small" && (
    <CardSmall
      title={race.pageTitle}
      url={url}
      image={race.featuredImage.image}
      imageAlt={race.featuredImage.alt}
    />
  )
}

{
  size === "wide" && (
    <CardWide
      title={race.pageTitle}
      url={url}
      image={race.featuredImage.image}
      imageAlt={race.featuredImage.alt}
    />
  )
}
