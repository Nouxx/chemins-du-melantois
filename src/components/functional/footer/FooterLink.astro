---
import Link from "@components/ui/atoms/Link.astro";
import ListItem from "@components/ui/molecules/ListItem.astro";

interface Props {
  name: string;
  url: string;
  newTab?: boolean;
}

const { name, url, newTab = true } = Astro.props;

const baseClasses = [
  "inline-flex gap-x-2",
  "rounded-lg",
  "text-neutral-600",
  "ring-zinc-500",
  "outline-hidden",
  "transition",
  "duration-300",
  "focus-visible:ring-3",
  "hover:text-neutral-500",
];
---

<ListItem disc={false}>
  <Link url={url} newTab={newTab} className={baseClasses.join(" ")}>
    {name}
  </Link>
</ListItem>
