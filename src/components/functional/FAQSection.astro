---
import Body from "@/components/ui/atoms/Body.astro";
import Flex from "@/components/ui/atoms/Flex.astro";
import Grid from "@/components/ui/atoms/Grid.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import Section from "@/components/ui/atoms/Section.astro";
import AccordionItem from "@/components/ui/molecules/AccordionItem.astro";
import { faqsData } from "@/data_files/faq/faq";

const makeId = (base: any, index: any) => `${base}${index + 1}`;
---

<Section>
  <Grid gap={10} className="md:grid-cols-5">
    <div class="md:col-span-2">
      <Flex direction="col" gap={4} className="max-w-xs">
        <Heading size="medium">Questions fréquemment posées</Heading>

        <Body>
          Trouvez rapidement des réponses aux questions que l'on nous pose
          chaque année.
        </Body>
      </Flex>
    </div>

    <div class="md:col-span-3">
      <div
        class="hs-accordion-group divide-y divide-neutral-200 dark:divide-neutral-700"
      >
        {
          faqsData.map((question, index) => {
            let id = makeId(
              "hs-basic-with-title-and-arrow-stretched-heading-",
              index
            );
            let collapseId = makeId(
              "hs-basic-with-title-and-arrow-stretched-collapse",
              index
            );

            return (
              <AccordionItem
                {...question}
                id={id}
                collapseId={collapseId}
                first={index === 0}
              />
            );
          })
        }
      </div>
    </div>
  </Grid>
</Section>
