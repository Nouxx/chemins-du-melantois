---
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import LinkButton from "@components/ui/molecules/LinkButton.astro";
import CTASection from "@components/ui/molecules/CTASection.astro";
import { routes } from "@data/navigation/routes/routes";
import { t } from "@lib/i18n";
import { externalLinks } from "@data/navigation/externalLinks/externalLinks";
---

<CTASection>
  <Heading slot="heading">{t("homepage.banner.title")}</Heading>

  <Text slot="subTitle">{t("homepage.banner.message")}</Text>

  <LinkButton
    slot="button"
    label={t("homepage.banner.label")}
    url={externalLinks.registration}
  />
</CTASection>
