---
import RegisterButton from "@components/functional/registration/RegisterButton.astro";
import PrimaryCTA from "@components/functional/ui/PrimaryCTA.astro";
import Body from "@components/ui/atoms/Body.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import CTASection from "@components/ui/molecules/CTASection.astro";
import { routes } from "@data/navigation/routes/routes";
---

<CTASection>
  <Heading slot="heading">Rendez-vous en 2026 !</Heading>
  <Body slot="subTitle">
    Venez vibrer à nouveau en 2026 sur des parcours conviviaux et 100 % nature !
  </Body>
  <PrimaryCTA slot="button" label="Résultats & Photos" url={routes.afterRace} />
</CTASection>
