---
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import LinkButton from "@components/ui/molecules/LinkButton.astro";
import CTASection from "@components/ui/molecules/CTASection.astro";
import { routes } from "@data/navigation/routes/routes";
import { t2 } from "@lib/i18n";
---

<CTASection>
  <Heading slot="heading">{t2("homepage.banner.title")}</Heading>

  <Text slot="subTitle">{t2("homepage.banner.message")}</Text>

  <LinkButton
    slot="button"
    label={t2("homepage.banner.label")}
    url={routes.afterRace}
  />
</CTASection>
