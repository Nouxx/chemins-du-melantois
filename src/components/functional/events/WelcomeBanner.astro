---
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import heroImage from "@images/hero-image.webp";
import LeftAndRightSection from "@components/ui/atoms/LeftAndRightSection.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import ImageWrapper from "@components/ui/atoms/ImageWrapper.astro";
import { routes } from "@data/navigation/routes/routes";
import LinkButton from "@components/ui/molecules/LinkButton.astro";
import Translation from "@components/ui/atoms/Translation.astro";
import { t2 } from "@lib/i18n";
---

<LeftAndRightSection>
  <Flex slot="left" direction="col" gap={8}>
    <Heading tag="h1">
      <Translation
        i18nKey="homepage.welcomeSection.title"
        slots={[{ type: "color" }]}
      />
    </Heading>

    <Text>
      {t2("homepage.welcomeSection.message")}
    </Text>

    <Flex direction="row" gap={4} wrap="wrap">
      <LinkButton
        label={t2("homepage.welcomeSection.link")}
        url={routes.afterRace}
      />
    </Flex>
  </Flex>

  <ImageWrapper
    slot="right"
    image={heroImage}
    imageAlt={t2("homepage.welcomeSection.imageAlt")}
    sizes="(max-width: 640px) 100vw, (max-width: 1536px) 50vw, 438px"
    rounded
  />
</LeftAndRightSection>
