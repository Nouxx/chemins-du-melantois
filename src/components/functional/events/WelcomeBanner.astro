---
import Heading from "@components/ui/atoms/Heading.astro";
import Body from "@components/ui/atoms/Body.astro";
import heroImage from "@images/hero-image.webp";
import LeftAndRightSection from "@components/ui/atoms/LeftAndRightSection.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import ImageWrapper from "@components/ui/atoms/ImageWrapper.astro";
import { routes } from "@data/navigation/routes/routes";
import SecondaryCTA from "@components/ui/molecules/SecondaryCTA.astro";
import RegisterButton from "@components/functional/registration/RegisterButton.astro";
---

<LeftAndRightSection>
  <Flex slot="left" direction="col" gap={8}>
    <Heading tag="h1">
      Bienvenue aux Chemins du
      <span class="text-brand-light-green"> Mélantois</span>
    </Heading>

    <Body>
      L'édition 2025 des Chemins du Mélantois est désormais ouverte aux
      inscriptions ! Venez découvrir nos parcours de course et de vélo pour
      cette 14ème édition consécutive.
    </Body>

    <Flex direction="row" gap={4} wrap="wrap">
      <RegisterButton />
      <SecondaryCTA title="Courses" url={routes.races} />
    </Flex>
  </Flex>

  <ImageWrapper
    slot="right"
    image={heroImage}
    imageAlt="Coureurs au départ de la course des Chemins du Mélantois"
    sizes="(max-width: 640px) 100vw, (max-width: 1536px) 50vw, 438px"
    rounded
  />
</LeftAndRightSection>
