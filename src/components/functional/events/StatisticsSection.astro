---
import Text from "@components/ui/atoms/Text.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import Grid from "@components/ui/atoms/Grid.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Section from "@components/ui/atoms/Section.astro";
import StatBig from "@components/ui/molecules/StatBig.astro";
import StatSmall from "@components/ui/molecules/StatSmall.astro";
import { t2 } from "@lib/i18n";

const participantSinceStarted = 3200;
const raceTypeAvailable = 5;
---

<Section>
  <Flex direction="col" gap={4}>
    <Heading tag="h2">{t2("homepage.statisticsSection.heading")}</Heading>

    <Text className="mb-16 max-w-prose leading-relaxed">
      {t2("homepage.statisticsSection.description")}
    </Text>
  </Flex>

  <Grid gap={6} className="items-center lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-4">
      <StatBig
        title={String(participantSinceStarted)}
        subTitle={t2("homepage.statisticsSection.participantSinceStarted", {
          count: participantSinceStarted,
        })}
      />
    </div>

    <div
      class="relative lg:col-span-8 lg:before:absolute lg:before:-start-12 lg:before:top-0 lg:before:h-full lg:before:w-px lg:before:bg-neutral-300"
    >
      <Flex direction="row" gap={8} wrap="wrap" className="justify-between">
        <StatSmall
          title={t2("homepage.statisticsSection.fourteenth")}
          subTitle={t2("homepage.statisticsSection.eventSince2011")}
        />
        <StatSmall
          title={String(raceTypeAvailable)}
          subTitle={t2("homepage.statisticsSection.raceTypeAvailable", {
            count: raceTypeAvailable,
          })}
        />
        <StatSmall
          title={t2("homepage.statisticsSection.tenMinutes")}
          subTitle={t2("homepage.statisticsSection.fromLilleInCar")}
        />
      </Flex>
    </div>
  </Grid>
</Section>
