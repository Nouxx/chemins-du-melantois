---
import Text from "@components/ui/atoms/Text.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import Grid from "@components/ui/atoms/Grid.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Section from "@components/ui/atoms/Section.astro";
import AccordionItem from "@components/ui/molecules/AccordionItem.astro";
import { t2 } from "@lib/i18n";

const faqsData = [
  {
    question: t2("homepage.faqSection.faqs.0.question"),
    answer: t2("homepage.faqSection.faqs.0.answer"),
  },
  {
    question: t2("homepage.faqSection.faqs.1.question"),
    answer: t2("homepage.faqSection.faqs.1.answer"),
  },
  {
    question: t2("homepage.faqSection.faqs.2.question"),
    answer: t2("homepage.faqSection.faqs.2.answer"),
  },
  {
    question: t2("homepage.faqSection.faqs.3.question"),
    answer: t2("homepage.faqSection.faqs.3.answer"),
  },
  {
    question: t2("homepage.faqSection.faqs.4.question"),
    answer: t2("homepage.faqSection.faqs.4.answer"),
  },
];
---

<Section>
  <Grid gap={10} className="md:grid-cols-5">
    <div class="md:col-span-2">
      <Flex direction="col" gap={4} className="max-w-xs">
        <Heading size="medium">{t2("homepage.faqSection.heading")}</Heading>

        <Text>
          {t2("homepage.faqSection.description")}
        </Text>
      </Flex>
    </div>

    <div class="md:col-span-3">
      <div class="hs-accordion-group divide-y divide-neutral-200">
        {
          faqsData.map((question, index) => {
            return (
              <AccordionItem
                {...question}
                id={`faq-item-${index + 1}`}
                collapseId={`faq-item-${index + 1}-collapse`}
                first={index === 0}
              />
            );
          })
        }
      </div>
    </div>
  </Grid>
</Section>
