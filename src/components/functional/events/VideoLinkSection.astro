---
import Section from "@components/ui/atoms/Section.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import { externalLinks } from "@data/navigation/externalLinks/externalLinks";
import videoPreviewImage from "@images/video-preview.webp";
import Link from "@components/ui/atoms/Link.astro";
import ImageWrapper from "@components/ui/atoms/ImageWrapper.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import VideoOverlay from "@components/ui/molecules/VideoOverlay.astro";
import { t2 } from "@lib/i18n";

const imageClass =
  "h-full w-full object-cover object-center transition duration-[600ms] ease-[cubic-bezier(0.45,0,0.55,1)] group-hover:scale-110";
---

<Section>
  <Flex direction="col" gap={8}>
    <Heading size="medium" className="text-center">
      {t2("homepage.videoSection.title")}
    </Heading>

    <div
      class="group relative mx-auto w-full max-w-2xl overflow-hidden rounded-lg"
    >
      <Link url={externalLinks.edition2024Video} newTab>
        <VideoOverlay>
          <ImageWrapper
            image={videoPreviewImage}
            imageAlt={t2("homepage.videoSection.imageAlt")}
            className={imageClass}
          />
        </VideoOverlay>
      </Link>
    </div>
  </Flex>
</Section>
