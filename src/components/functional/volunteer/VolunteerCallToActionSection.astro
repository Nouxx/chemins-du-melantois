---
import Body from "@components/ui/atoms/Body.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import LinkButton from "@components/ui/atoms/LinkButton.astro";
import CTASection from "@components/ui/molecules/CTASection.astro";
import { SiteMetadata } from "@data/site/metadata";
---

<CTASection>
  <Heading slot="heading">Comment devenir bénévole ?</Heading>
  <Body slot="subTitle">L'aventure vous tente ? Contactez-nous !</Body>
  <LinkButton
    slot="button"
    label={`${SiteMetadata.contactEmail}`}
    url={`mailto:${SiteMetadata.contactEmail}`}
  />
</CTASection>
