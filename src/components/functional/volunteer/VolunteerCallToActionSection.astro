---
import Text from "@components/ui/atoms/Text.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import LinkButton from "@components/ui/molecules/LinkButton.astro";
import CTASection from "@components/ui/molecules/CTASection.astro";
import { SiteMetadata } from "@data/site/metadata";
---

<CTASection>
  <Heading slot="heading">Comment devenir bénévole ?</Heading>
  <Text slot="subTitle">L'aventure vous tente ? Contactez-nous !</Text>
  <LinkButton
    slot="button"
    label={SiteMetadata.contactEmail}
    url={`mailto:${SiteMetadata.contactEmail}`}
  />
</CTASection>
