---
import Text from "@components/ui/atoms/Text.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import Grid from "@components/ui/atoms/Grid.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Section from "@components/ui/atoms/Section.astro";
import imgVolunteersRegistration from "@images/volunteers/women-at-the-registration-desk.webp";
import imgVolunteersFood from "@images/volunteers/women-preparing-food.webp";
import imgVolunteersManCycling from "@images/volunteers/man-cycling-on-the-road.webp";
import imgVolunteersManTakingAPicture from "@images/volunteers/man-taking-pictures.webp";
import imgVolunteersInstallations from "@images/volunteers/finish-line-before-the-race.webp";
import imgVolunteersPosing from "@images/volunteers/volunteers-and-participant-posing.webp";
import VolunteerRoleGridCard from "@components/functional/volunteer/VolunteerRoleGridCard.astro";
import { t2 } from "@lib/i18n";

const MarshallRoleData = {
  role: t2("volunteersPage.rolesSection.marshall"),
  content: t2("volunteersPage.rolesSection.marshallDescription"),
  roleImage: {
    image: imgVolunteersManCycling,
    alt: t2("volunteersPage.rolesSection.marshallImageAlt"),
  },
};

const AidStationCrewRoleData = {
  role: t2("volunteersPage.rolesSection.aidStation"),
  content: t2("volunteersPage.rolesSection.aidStationDescription"),
  roleImage: {
    image: imgVolunteersFood,
    alt: t2("volunteersPage.rolesSection.aidStationImageAlt"),
  },
};

const SetupCrewRoleData = {
  role: t2("volunteersPage.rolesSection.setupCrew"),
  content: t2("volunteersPage.rolesSection.setupCrewDescription"),
  roleImage: {
    image: imgVolunteersInstallations,
    alt: t2("volunteersPage.rolesSection.setupCrewImageAlt"),
  },
};

const registrationCrewRoleData = {
  role: t2("volunteersPage.rolesSection.registration"),
  content: t2("volunteersPage.rolesSection.registrationDescription"),
  roleImage: {
    image: imgVolunteersRegistration,
    alt: t2("volunteersPage.rolesSection.registrationImageAlt"),
  },
};

const photographerRoleData = {
  role: t2("volunteersPage.rolesSection.photographer"),
  content: t2("volunteersPage.rolesSection.photographerDescription"),
  roleImage: {
    image: imgVolunteersManTakingAPicture,
    alt: t2("volunteersPage.rolesSection.photographerImageAlt"),
  },
};

const andMuchMoreRoleData = {
  role: t2("volunteersPage.rolesSection.muchMore"),
  content: t2("volunteersPage.rolesSection.muchMoreDescription"),
  roleImage: {
    image: imgVolunteersPosing,
    alt: t2("volunteersPage.rolesSection.muchMoreImageAlt"),
  },
};

const volunteerRolesData = [
  MarshallRoleData,
  AidStationCrewRoleData,
  SetupCrewRoleData,
  registrationCrewRoleData,
  photographerRoleData,
  andMuchMoreRoleData,
];
---

<Section>
  <Flex direction="col" gap={8}>
    <Flex direction="col" gap={4}>
      <Heading size="medium">{t2("volunteersPage.rolesSection.title")}</Heading>

      <Text>
        {t2("volunteersPage.rolesSection.description")}
      </Text>
    </Flex>

    <Grid gap={8} className="sm:grid-cols-2">
      {
        volunteerRolesData.map((volunteerRoleData) => (
          <VolunteerRoleGridCard
            role={volunteerRoleData.role}
            content={volunteerRoleData.content}
            roleImage={volunteerRoleData.roleImage}
          />
        ))
      }
    </Grid>
  </Flex>
</Section>
