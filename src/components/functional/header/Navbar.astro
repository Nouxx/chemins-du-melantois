---
import Flex from "@components/ui/atoms/Flex.astro";
import Link from "@components/ui/atoms/Link.astro";
import MobileBurgerMenu from "@components/functional/header/MobileBurgerMenu.astro";
import NavLinks from "@components/functional/header/NavLinks.astro";
import BrandLogo from "@components/functional/header/BrandLogo.astro";
import { routes } from "@data/navigation/routes/routes";
---

<Flex
  renderAs="header"
  direction="row"
  wrap="wrap"
  className="sticky inset-x-0 top-4 z-50 w-full text-sm md:flex-nowrap md:justify-start"
>
  <nav
    class="relative mx-2 w-full rounded-[36px] border border-yellow-100/40 bg-yellow-50/60 px-4 py-3 backdrop-blur-md md:flex md:items-center md:justify-between md:px-6 md:py-0 lg:px-8 xl:mx-auto"
    aria-label="Global"
  >
    <Flex direction="row" className="items-center justify-between">
      <Link
        url={routes.home}
        className="flex-none rounded-lg"
        aria-label="Brand"
      >
        <BrandLogo class="h-auto w-14 p-1" />
      </Link>

      <MobileBurgerMenu />
    </Flex>

    <NavLinks />
  </nav>
</Flex>
