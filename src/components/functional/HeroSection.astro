---
import { Image } from "astro:assets";
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import Section from "@/components/ui/atoms/Section.astro";
import Body from "@/components/ui/atoms/Body.astro";
import RegisterButton from "@/components/functional/RegisterButton.astro";
import { routes } from "@/data_files/constants";
import heroImage from "@images/hero-image.webp";
---

<Section>
  <div class="md:max-w-[50%]">
    <Heading tag="h1">
      Bienvenue aux Chemins du
      <span class="text-brand-light-green"> Mélantois</span>
    </Heading>

    <Body className="mt-3 lg:w-4/5">
      L'édition 2025 des Chemins du Mélantois est désormais ouverte aux
      inscriptions ! Venez découvrir nos parcours de course et de vélo pour
      cette 14ème édition consécutive.
    </Body>

    <div class="mt-7 grid w-full gap-3 md:inline-flex">
      <RegisterButton />
      <SecondaryCTA title="Courses" url={routes.races} />
    </div>
  </div>
  <div class="image__placeholder w-full overflow-hidden rounded-md">
    {
      (
        <Image
          src={heroImage}
          alt="Coureurs au départ de la course des Chemins du Mélantois"
          class="w-full scale-110 object-cover object-center"
          draggable={"false"}
          format={"avif"}
          style={{
            height: "100%",
          }}
          sizes="(max-width: 640px) 100vw, (max-width: 1536px) 50vw, 438px"
        />
      )
    }
  </div>
</Section>
