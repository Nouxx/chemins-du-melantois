---
import RaceCard from "@/components/functional/RaceCard.astro";
import { racesPageData } from "@/data_files/races/races";
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
  {
    racesPageData.map((racePageData, index) => {
      if (index !== 1) {
        return <RaceCard racePageData={racePageData} size="small" />;
      } else {
        return <RaceCard racePageData={racePageData} size="wide" />;
      }
    })
  }
</div>
