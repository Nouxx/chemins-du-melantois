---
import RaceBibSection from "@components/functional/races/RaceBibSection.astro";
import RaceDescriptionSection from "@components/functional/races/RaceDescriptionSection.astro";
import RaceHeadingSection from "@components/functional/races/RaceHeadingSection.astro";
import RaceRegulationsSection from "@components/functional/races/RaceRegulationsSection.astro";
import RaceRewardsSection from "@components/functional/races/RaceRewardsSection.astro";
import RaceScheduleSection from "@components/functional/races/RaceScheduleSection.astro";
import RaceRegistrationSection from "@components/functional/races/registration/RaceRegistrationSection.astro";
import RaceRegistrationDetailsSection from "@components/functional/races/registrationDetails/RaceRegistrationDetailsSection.astro";
import Flex from "@components/ui/atoms/Flex.astro";
import type { RacePageData } from "@data/races/schema";

interface Props {
  data: RacePageData;
}

const { data } = Astro.props;
---

<Flex direction="col" gap={14} renderAs="article">
  <RaceHeadingSection data={data} />

  <RaceDescriptionSection data={data.routeSection} />

  <RaceScheduleSection data={data.scheduleSection} />

  <RaceRewardsSection data={data.rewardsSection} />

  <RaceRegistrationSection data={data.registrationSection} />

  <RaceBibSection data={data.bibSection} />

  <RaceRegistrationDetailsSection data={data.registrationDetailsSection} />

  <RaceRegulationsSection data={data.regulationSection} />
</Flex>
