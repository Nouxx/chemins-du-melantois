---
import LinkButton from "@/components/ui/atoms/LinkButton.astro";

interface Props {
  label: string;
  url: string;
  arrow?: boolean;
  openInNewTab?: boolean;
  disabled?: boolean;
}

const {
  label,
  url,
  arrow = false,
  openInNewTab = false,
  disabled = false,
} = Astro.props;

const target = openInNewTab ? "_blank" : "_self";
---

<LinkButton
  label={label}
  url={url}
  color="green"
  icon={arrow}
  target={target}
  disabled={disabled}
/>
