---
import LinkButton from "@components/ui/atoms/LinkButton.astro";

interface Props {
  label: string;
  url: string;
  openInNewTab?: boolean;
  disabled?: boolean;
}

const { label, url, openInNewTab = false, disabled = false } = Astro.props;

const target = openInNewTab ? "_blank" : "_self";
// todo: should be renamed as CTAButton
---

<LinkButton
  label={label}
  url={url}
  color="green"
  icon
  target={target}
  disabled={disabled}
/>
