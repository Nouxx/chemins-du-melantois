---
import PrimaryCTA from "@/components/functional/PrimaryCTA.astro";
import Section from "@/components/ui/atoms/Section.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import Body from "@/components/ui/atoms/Body.astro";
import { routes } from "@/data_files/constants";
import IconBlock from "@/components/ui/molecules/IconBlock.astro";
import Grid from "@/components/ui/atoms/Grid.astro";
import Flex from "@/components/ui/atoms/Flex.astro";
---

<Section>
  <Grid gap={8} className="lg:mt-16 lg:grid-cols-3 lg:gap-12">
    <Flex direction="col" gap={5} className="lg:col-span-1">
      <Heading size="small">Nos 5 courses</Heading>

      <Body>
        Cette édition 2025 propose notre format habituel de 5 courses variées,
        parfait pour un événement familial où chacun peut venir et courir
        ensemble.
      </Body>

      <PrimaryCTA label="Détails des courses" url={routes.races} />
    </Flex>

    <div class="lg:col-span-2">
      <Grid gap={8} className="sm:grid-cols-2 md:gap-12">
        <IconBlock
          title="Course à pied - 10 km"
          subTitle="11€ par participant"
          body="La boucle de 10km traverse le Bois de la Noyelle, l'étang de pêche de Sainghin, jusqu'à effleurer les Marais de la Marque."
          iconName="manRunning"
          iconColor="brandOrange"
        />

        <IconBlock
          title="Course à pied - 5 km"
          subTitle="7€ par participant"
          body="Un parcours nature. Partez à la découverte des plus beaux paysages du Mélantois à travers la nature : Le Bois de la Noyelle Les rives de la Marque Profitez d'un parcours composé à 70 % de chemins plus proche du trail que de la course sur route."
          iconName="manRunning"
          iconColor="brandOrange"
        />

        <IconBlock
          title="Courses à pied - 900 m"
          subTitle="Gratuit"
          body="2 parcours de découverte familial, adapté pour les enfants et leurs familles souhaitant découvrir la course à pied à travers le village de Sainghin-en-Mélantois ou de Péronne-en-Mélantois."
          iconName="manRunning"
          iconColor="brandOrange"
        />

        <IconBlock
          title="Run & Bike"
          subTitle="9€ par équipe"
          body="Une épreuve au départ de Péronne composée d'une équipe avec deux catégorie d'âge: un coureur à pied adulte, un ou une jeune cycliste qui joue le rôle de lièvre et supporte le coureur à pied. L'épreuve inter-générationnelle par nature."
          iconName="manBiking"
          iconColor="brandOrange"
        />
      </Grid>
    </div>
  </Grid>
</Section>
