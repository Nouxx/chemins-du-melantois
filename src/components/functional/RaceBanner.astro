---
import Body from "@/components/ui/atoms/Body.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import CTABanner from "@/components/ui/molecules/CTABanner.astro";
---

<CTABanner>
  <Heading slot="heading" size="medium" classNames="whitespace-nowrap">
    Nos Courses
  </Heading>
  <Body slot="subTitle" className="max-w-(--breakpoint-sm)">
    5 distances, 5 ambiances, une même passion ! Que vous soyez coureur aguerri,
    amateur de nature ou en famille, nos parcours s'adaptent à tous les profils.
    Découvrez les paysages du Mélantois à travers des épreuves conviviales,
    accessibles et bien encadrées.
  </Body>
</CTABanner>
