---
import { undefined } from "astro:schema";
import { Icons } from "./icons.ts";

interface Path {
  d: string;
  class?: string;
}

interface Props {
  name: string;
  fill?: string;
  className?: string;
}

const { name, fill, className } = Astro.props;

let icon = (Icons as any)[name] || {};

let paths: Path[] = icon.paths || [];

const fillClass = fill ? `text-${fill}` : "";
---

{
  icon ? (
    <svg
      class={`${className ?? ""} ${icon.class} fill-${fill} ${fillClass}`}
      height={icon.height}
      viewBox={icon.viewBox}
      width={icon.width}
      fill={icon.fill}
      clip-rule={icon.clipRule}
      fill-rule={icon.fillRule}
      stroke={icon.stroke}
      stroke-width={icon.strokeWidth}
      stroke-linecap={icon.strokeLinecap}
      stroke-linejoin={icon.strokeLinejoin}
    >
      <title>{icon.title}</title>
      {paths.map((path: Path) => (
        <path d={path.d} class={path.class || ""} />
      ))}
    </svg>
  ) : (
    "Icon not found"
  )
}
