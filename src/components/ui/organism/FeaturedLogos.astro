---
import type { SvgLogoLink } from "@/data_files/types";

const { title, subTitle, logoLinks } = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  logoLinks: SvgLogoLink[];
}
---

<div class="mx-auto mb-6 w-full space-y-1 text-center">
  <h2
    class="text-2xl leading-tight font-bold text-balance text-neutral-800 sm:text-3xl dark:text-neutral-200"
  >
    {title}
  </h2>
  {
    subTitle && (
      <p class="leading-tight text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )
  }
</div>
<div
  class="flex flex-col items-center justify-center gap-y-2 sm:flex-row sm:gap-x-12 sm:gap-y-0 lg:gap-x-24"
>
  {
    logoLinks.map((logoLink) => (
      <a
        href={logoLink.link.href}
        target="_blank"
        aria-label={logoLink.link.name}
        rel="noopener noreferrer"
      >
        <div set:html={logoLink.svg} />
      </a>
    ))
  }
</div>
