---
import Button from "@components/ui/atoms/Button.astro";
import Link from "@components/ui/atoms/Link.astro";
import Icon from "@components/ui/atoms/icons/Icon.astro";

interface Props {
  label: string;
  url: string;
  icon?: boolean;
  newTab?: boolean;
  disabled?: boolean;
}

const { label, url, newTab = false, disabled = false } = Astro.props;

const iconMovementClasses = [
  "transition",
  "duration-300",
  "group-hover:translate-x-1",
].join(" ");
---

{
  disabled ? (
    <Button label={label} disabled>
      <Icon
        slot="icon"
        size="medium"
        name="arrowRight"
        className={iconMovementClasses}
      />
    </Button>
  ) : (
    <Link url={url} newTab={newTab} className="w-fit h-fit">
      <Button label={label}>
        <Icon
          slot="icon"
          size="medium"
          name="arrowRight"
          className={iconMovementClasses}
        />
      </Button>
    </Link>
  )
}
