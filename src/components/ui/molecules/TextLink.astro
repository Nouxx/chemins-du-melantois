---
import Body from "@components/ui/atoms/Body.astro";
import Link from "@components/ui/atoms/Link.astro";
import Icon from "@components/ui/icons/Icon.astro";

interface Props {
  url: string;
}

const { url } = Astro.props;
---

<Body
  size="small"
  fontStyle="bold"
  color="darkNeutral"
  className="hover:underline hover:underline-offset-2"
>
  <Link url={url} newTab className="link__text">
    <slot />
    <Icon name="openInNew" />
  </Link>
</Body>
