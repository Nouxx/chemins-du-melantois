---
import { cva, cx, type VariantProps } from "class-variance-authority";

const list = cva([], {
  variants: {
    spaceY: {
      0: "space-y-0",
      1: "space-y-1",
      2: "space-y-2",
      3: "space-y-3",
      4: "space-y-4",
      5: "space-y-5",
      6: "space-y-6",
      7: "space-y-7",
      8: "space-y-8",
      9: "space-y-9",
      10: "space-y-10",
    },
  },
  defaultVariants: {
    spaceY: 2,
  },
});

type Variants = VariantProps<typeof list>;

interface Props extends Variants {
  className?: string;
}

const { className, spaceY } = Astro.props;

const listClasses = cx(list({ spaceY }), className);
---

<ul class={listClasses}>
  <slot />
</ul>
