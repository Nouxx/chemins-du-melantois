---
interface Props {
  flex?: boolean;
}

const { flex = false } = Astro.props;

const flexClasses = flex ? "flex flex-col md:flex-row" : undefined;
---

<section
  class=`mx-auto max-w-[85rem] items-stretch gap-4 px-4 py-14 sm:px-6 md:gap-8 lg:px-8 2xl:max-w-full ${flexClasses}`
>
  <slot />
</section>
