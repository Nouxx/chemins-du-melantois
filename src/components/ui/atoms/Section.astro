---
import { cx } from "class-variance-authority";

interface Props {
  className?: string;
}

const { className } = Astro.props;

const classes = [
  "items-stretch",
  "mx-auto",
  "max-w-[85rem]",
  "2xl:max-w-full",
  "px-4",
  "py-14",
  "sm:px-6",
];

const mergedClasses = cx(classes, className);
---

<section class={mergedClasses}>
  <slot />
</section>
