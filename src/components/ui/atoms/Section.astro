---
import { cva, cx, type VariantProps } from "class-variance-authority";

interface Props {
  flex?: Variants["flex"];
  gap?: number;
  className?: string;
}

const { flex, className, gap } = Astro.props;

const section = cva(
  [
    "items-stretch",
    "mx-auto",
    "max-w-[85rem]",
    "2xl:max-w-full",
    "px-4",
    "sm:px-6",
    "py-14",
  ],
  {
    variants: {
      flex: {
        col: "flex flex-col",
        row: "flex flex-row",
        none: undefined,
      },
    },
    defaultVariants: { flex: "none" },
  }
);

const gapClass = gap ? `gap-${gap}` : undefined;

type Variants = VariantProps<typeof section>;
---

<section class={cx(section({ flex }), gapClass, className)}>
  <slot />
</section>
