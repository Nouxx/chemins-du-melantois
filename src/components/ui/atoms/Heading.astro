---
import { cva, type VariantProps } from "class-variance-authority";

// todo: refactor
type ValidTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

const VALID_TAGS = ["h1", "h2", "h3", "h4", "h5", "h6"];

function isValidTag(string: string | undefined): string is ValidTag {
  if (!string) return false;
  return VALID_TAGS.includes(string);
}

// todo: astro props must be declared before destructure
interface Props {
  id?: string;
  tag?: string;
  size?: Variants["size"];
  classNames?: string;
}

const { id, tag, size, classNames } = Astro.props;

const Tag: ValidTag = isValidTag(tag) ? tag : "h1";

const heading = cva(
  ["font-bold", "tracking-tight", "text-balance", "leading-tight", classNames],
  {
    variants: {
      size: {
        xsmall: "text-2xl",
        small: "text-3xl sm:text-4xl",
        medium: "text-3xl sm:text-4xl lg:text-5xl",
        large: "text-3xl sm:text-4xl lg:text-6xl",
      },
      color: {
        neutral: "text-neutral-800",
      },
    },
    defaultVariants: {
      size: "large",
      color: "neutral",
    },
  }
);

type Variants = VariantProps<typeof heading>; // todo: move this up?

const classes = heading({ size });
---

<Tag id={id} class={classes}>
  <slot />
</Tag>
