---
import type { HTMLTag } from "astro/types";
import { cva, type VariantProps, cx } from "class-variance-authority";

const flex = cva("flex", {
  variants: {
    direction: {
      row: "flex-row",
      col: "flex-col",
    },
    wrap: {
      wrap: "flex-wrap",
      reverse: "flex-wrap-reverse",
      noWrap: "flex-nowrap",
    },
    items: {
      start: "items-start",
      end: "items-end",
      center: "items-center",
      stretch: "items-stretch",
    },
    justify: {
      start: "justify-start",
      end: "justify-end",
      center: "justify-center",
      between: "justify-between",
      around: "justify-around",
      evenly: "justify-evenly",
    },
    gap: {
      2: "gap-2",
      4: "gap-4",
      6: "gap-6",
      8: "gap-8",
      14: "gap-14",
    },
  },
  defaultVariants: {
    direction: "row",
    wrap: "noWrap",
  },
});

type Variants = VariantProps<typeof flex>;

interface Props extends Variants {
  className?: string;
  renderAs?: HTMLTag;
}

const { direction, gap, className, renderAs, wrap, items, justify } =
  Astro.props;

const Tag = renderAs ?? "div";

const mergedClasses = cx(
  flex({ direction, wrap, items, justify, gap }),
  className
);
---

<Tag class={mergedClasses}>
  <slot />
</Tag>
