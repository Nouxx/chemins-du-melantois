---
import { gapVariants } from "@components/ui/props/gap";
import type { HTMLTag } from "astro/types";
import { cva, type VariantProps, cx } from "class-variance-authority";

const flex = cva("flex", {
  variants: {
    direction: {
      row: "flex-row",
      col: "flex-col",
    },
    wrap: {
      wrap: "flex-wrap",
      reverse: "flex-wrap-reverse",
      noWrap: "flex-nowrap",
    },
    items: {
      start: "items-start",
      end: "items-end",
      center: "items-center",
      stretch: "items-stretch",
    },
    justify: {
      start: "justify-start",
      end: "justify-end",
      center: "justify-center",
      between: "justify-between",
      around: "justify-around",
      evenly: "justify-evenly",
    },
    gap: gapVariants,
  },
  defaultVariants: {
    direction: "row",
    wrap: "noWrap",
  },
});

type Variants = VariantProps<typeof flex>;

interface Props extends Variants {
  className?: string;
  renderAs?: HTMLTag;
}

const { direction, gap, className, renderAs, wrap, items, justify } =
  Astro.props;

const Tag = renderAs ?? "div";

const flexClasses = cx(
  flex({ direction, wrap, items, justify, gap }),
  className
);
---

<Tag class={flexClasses}>
  <slot />
</Tag>
