---
import { cx } from "class-variance-authority";

interface Props {
  gap?: number;
  className?: string;
}

const { gap, className = "" } = Astro.props;

const gapClass = gap ? `gap-${gap}` : undefined;

const mergedClasses = cx("grid", gapClass, className);
---

<div class={mergedClasses}>
  <slot />
</div>
