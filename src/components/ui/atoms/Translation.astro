---
import { textColorVariants } from "@components/ui/props/typography";
import { t2 } from "@lib/i18n";
import { cva, type VariantProps } from "class-variance-authority";

// AFAIK, Astro does not support passing components as props
// https://github.com/withastro/astro/issues/3964

const SLOTS_TYPES = ["color", "strong", "italic", "link"] as const;

type SlotType = (typeof SLOTS_TYPES)[number];

const colorClasses = cva(undefined, {
  variants: {
    color: textColorVariants,
  },
  defaultVariants: {
    color: "lightGreen",
  },
});

type ColorVariants = VariantProps<typeof colorClasses>;

interface Props {
  i18nKey?: string;
  input?: string;
  slots: Slot[];
}

const { i18nKey, input, slots } = Astro.props;

const slotsClassesMapping: Partial<Record<SlotType, string | undefined>> = {
  strong: "font-bold",
  italic: "italic",
  link: "underline underline-offset-2",
};

type Slot =
  | {
      type: "strong" | "italic";
    }
  | {
      type: "link";
      to: string;
    }
  | {
      type: "color";
      color?: ColorVariants["color"];
    };

type TagType = "opening" | "closing";

const openingTagsRegexPattern = new RegExp(/<\d+>/, "g");
const closingTagsRegexPattern = new RegExp(/<\/\d+>/, "g");
const allTagsRegexPattern = new RegExp(/<(\/)?\d+>/, "g");

/**
 * returns the number inside the tag
 *
 * example: `<1>` => `1`
 */
function stripTag(input: string, type: TagType): number {
  let result;

  // is conditional necessary?
  if (type === "opening") {
    result = parseInt(input.replace("<", "").replace(">", ""));
  }

  if (type === "closing") {
    result = parseInt(input.replace("<", "").replace(">", "").replace("/", ""));
  }

  if (!result || isNaN(result)) {
    throw new Error(`Could not strip tag from ${input}`);
  }

  return result;
}

function getTagType(rawTag: string): TagType {
  if (rawTag.startsWith("</") && rawTag.endsWith(">")) {
    return "closing";
  }
  if (rawTag.startsWith("<") && rawTag.endsWith(">")) {
    return "opening";
  }

  throw new Error(`Could not determine tag type from ${rawTag}`);
}

function getStrippedTags(string: string, type: TagType) {
  if (type === "opening") {
    const matches =
      string.match(new RegExp(openingTagsRegexPattern, "g")) || [];
    return matches.map((tag) => stripTag(tag, "opening"));
  }

  if (type === "closing") {
    const matches =
      string.match(new RegExp(closingTagsRegexPattern, "g")) || [];
    return matches.map((tag) => stripTag(tag, "closing"));
  }

  throw new Error(`Unsupported tag type: ${type}`);
}

function tagsMatch(openingTags: number[], closingTags: number[]): boolean {
  if (openingTags.length !== closingTags.length) {
    return false;
  }

  const sortedOpeningTags = openingTags.slice().sort((a, b) => a - b);
  const sortedClosingTags = closingTags.slice().sort((a, b) => a - b);

  if (sortedClosingTags.toString() !== sortedOpeningTags.toString()) {
    return false;
  }

  return true;
}

function interpolateString(translatedString: string) {
  const openingTags = getStrippedTags(translatedString, "opening");
  const closingTags = getStrippedTags(translatedString, "closing");

  if (!tagsMatch(openingTags, closingTags)) {
    throw new Error(
      `Opening slots (${openingTags}) and closing slots (${closingTags}) does not match.`
    );
  }

  return translatedString.replace(
    new RegExp(allTagsRegexPattern, "g"),
    (tag) => {
      return getHTMLMarkupForSlot(
        stripTag(tag, getTagType(tag)) - 1,
        getTagType(tag)
      );
    }
  );
}

function getHTMLMarkupForSlot(slotIndex: number, tagType: TagType) {
  const slot = slots[slotIndex];

  if (!slot) {
    throw new Error(`No slot found at position ${slotIndex + 1}`);
  }

  if (tagType === "opening") {
    if (slot.type === "link") {
      return `<a href="${slot.to}" class="${slotsClassesMapping["link"]}">`;
    }

    if (slot.type === "color") {
      const classes = colorClasses({ color: slot.color });
      return `<span class="${classes}">`;
    }

    const classes = slotsClassesMapping[slot.type];
    return `<span class="${classes}">`;
  }

  if (tagType === "closing") {
    if (slot.type === "link") {
      return `</a>`;
    }
    return `</span>`;
  }

  throw new Error(`Unsupported tag type: ${tagType}`);
}

if (!i18nKey && !input) {
  throw new Error("At least i18nKey or input must be provided");
}

const translatedString = input ?? t2(i18nKey as string);

const interpolatedString = interpolateString(translatedString);
---

<Fragment set:html={interpolatedString} />
