---
import { textColorVariants } from "@components/ui/props/typography";
import { t } from "@lib/i18n";
import { cva, type VariantProps } from "class-variance-authority";

const SUPPORTED_TAG = ["color", "strong", "italic", "link"] as const;

type SupportedTag = (typeof SUPPORTED_TAG)[number];

const colorClasses = cva(undefined, {
  variants: {
    color: textColorVariants,
  },
  defaultVariants: {
    color: "lightGreen",
  },
});

interface Props {
  i18nKey?: string;
  input?: string;
  slots: Slot[];
}

const { i18nKey, input, slots } = Astro.props;

const tagClassesMapping: Partial<Record<SupportedTag, string | undefined>> = {
  strong: "font-bold",
  italic: "italic",
  link: "underline underline-offset-2",
};

type ColorVariants = VariantProps<typeof colorClasses>;

type Slot =
  | {
      type: "strong" | "italic";
    }
  | {
      type: "link";
      to: string;
    }
  | {
      type: "color";
      color?: ColorVariants["color"];
    };

type TagType = "opening" | "closing";

const openingTagsRegexPattern = new RegExp(/<\d+>/, "g");
const closingTagsRegexPattern = new RegExp(/<\/\d+>/, "g");
const allTagsRegexPattern = new RegExp(/<(\/)?\d+>/, "g");

function stripTag(input: string, type: TagType): number {
  let result;

  if (type === "opening") {
    result = parseInt(input.replace("<", "").replace(">", ""));
  }

  if (type === "closing") {
    result = parseInt(input.replace("<", "").replace(">", "").replace("/", ""));
  }

  if (!result) {
    throw new Error(`Could not strip tag from ${input}`);
  }

  if (isNaN(result)) {
    throw new Error(`Could not strip tag from ${input}`);
  }

  return result;
}

function getTagType(input: string): TagType {
  if (input.startsWith("</") && input.endsWith(">")) {
    return "closing";
  }
  if (input.startsWith("<") && input.endsWith(">")) {
    return "opening";
  }

  throw new Error(`Could not determine tag type from ${input}`);
}

function getSlotsIndexes(input: string, type: TagType) {
  if (type === "opening") {
    const matches = input.match(new RegExp(openingTagsRegexPattern, "g")) || [];
    return matches.map((tag) => stripTag(tag, "opening"));
  }

  if (type === "closing") {
    const matches = input.match(new RegExp(closingTagsRegexPattern, "g")) || [];
    return matches.map((tag) => stripTag(tag, "closing"));
  }

  throw new Error(`Unsupported tag type: ${type}`);
}

function indexesMatch(
  openingIndexes: number[],
  closingIndexes: number[]
): boolean {
  if (openingIndexes.length !== closingIndexes.length) {
    return false;
  }

  const sortedOpeningIndexes = openingIndexes.slice().sort((a, b) => a - b);
  const sortedClosingIndexes = closingIndexes.slice().sort((a, b) => a - b);

  if (sortedClosingIndexes.toString() !== sortedOpeningIndexes.toString()) {
    return false;
  }

  return true;
}

function interpolateString(translatedString: string) {
  const openingTags = getSlotsIndexes(translatedString, "opening");
  const closingTags = getSlotsIndexes(translatedString, "closing");

  if (!indexesMatch(openingTags, closingTags)) {
    throw new Error(
      `Opening tags (${openingTags}) and closing tags (${closingTags}) does not match.`
    );
  }

  return translatedString.replace(
    new RegExp(allTagsRegexPattern, "g"),
    (tag) => {
      return getHTMLMarkupForSlot(
        stripTag(tag, getTagType(tag)) - 1,
        getTagType(tag)
      );
    }
  );
}

function getHTMLMarkupForSlot(index: number, type: TagType) {
  const slot = slots[index];

  if (!slot) {
    throw new Error(`No slot found for index ${index + 1}`);
  }

  if (type === "opening") {
    if (slot.type === "link") {
      return `<a href="${slot.to}" class="${tagClassesMapping["link"]}">`;
    }

    if (slot.type === "color") {
      const classes = colorClasses({ color: slot.color });
      return `<span class="${classes}">`;
    }

    const classes = tagClassesMapping[slot.type];
    return `<span class="${classes}">`;
  }

  if (type === "closing") {
    if (slot.type === "link") {
      return `</a>`;
    }
    return `</span>`;
  }

  throw new Error(`Unsupported tag type: ${type}`);
}

if (!i18nKey && !input) {
  throw new Error("At least i18nKey or input must be provided");
}

const translatedString = input ?? t(i18nKey as string);

const interpolatedString = interpolateString(translatedString);
---

<Fragment set:html={interpolatedString} />
