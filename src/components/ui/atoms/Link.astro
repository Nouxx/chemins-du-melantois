---
import type { HTMLTag } from "astro/types";
import { cx } from "class-variance-authority";

type AnchorRel = "nofollow" | "noopener" | "noreferrer" | "noopener noreferrer";

interface Props {
  url: string;
  preFetch?: boolean;
  className?: string;
  newTab?: boolean;
  ariaCurrent?: "page";
  ariaLabel?: string;
  rel?: AnchorRel[];
  renderAs?: HTMLTag;
}

const {
  url,
  preFetch = true,
  className,
  newTab = false,
  ariaCurrent,
  ariaLabel,
  rel,
  renderAs,
} = Astro.props;

const focusClasses = "group ring-zinc-500 outline-hidden focus-visible:ring-3";
const relValues = rel?.join(" ");

const mergedClasses = cx(focusClasses, className);

const Tag = renderAs ?? "a";
---

<Tag
  href={url}
  data-astro-prefetch={preFetch}
  class={mergedClasses}
  target={newTab ? "_blank" : "_self"}
  aria-current={ariaCurrent}
  aria-label={ariaLabel}
  rel={relValues}
>
  <slot />
</Tag>
