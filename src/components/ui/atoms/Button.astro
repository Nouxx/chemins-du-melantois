---
import { fontWeightVariants } from "@components/ui/props/typography";
import { cva, type VariantProps } from "class-variance-authority";

const baseClasses = [
  "group",
  "inline-flex",
  "items-center",
  "justify-center",
  "w-fit",
  "gap-x-2",
  "rounded-lg px-4",
  "py-3",
  "text-sm",
  "ring-zinc-500",
  "transition",
  "duration-300",
  "focus-visible:ring-3",
  "outline-hidden",
  "ring-zinc-500",
];

const button = cva(baseClasses, {
  variants: {
    color: {
      green:
        "text-neutral-50 bg-brand-dark-green hover:bg-brand-light-green border-transparent",
      neutral:
        "text-neutral-600 bg-neutral-300 hover:bg-neutral-400/50 shadow-xs border-neutral-200",
    },
    fontStyle: fontWeightVariants,
    disabled: {
      true: "pointer-events-none opacity-50",
      false: undefined,
    },
  },
  defaultVariants: {
    color: "green",
    fontStyle: "bold",
    disabled: false,
  },
});

type Variants = VariantProps<typeof button>;

interface Props extends Variants {
  label: string;
  newTab?: boolean;
  disabled?: boolean;
}

const { label, color, fontStyle, disabled } = Astro.props;

const buttonClasses = button({ color, fontStyle, disabled });
---

<button class={buttonClasses}>
  {label}
  <slot name="icon" />
</button>
