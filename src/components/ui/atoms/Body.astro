---
import { cva, type VariantProps } from "class-variance-authority";

const defineHtmlTags = <T extends keyof HTMLElementTagNameMap>(tags: T[]) =>
  tags;

const validTags = defineHtmlTags(["p", "li"]);

type ValidTag = (typeof validTags)[number];

const body = cva(["text-pretty"], {
  variants: {
    size: {
      xsmall: "text-sm",
      small: "text-md sm:text-lg",
      lg: "text-lg sm:text-xl",
      "6xl": "text-6xl",
      "3xl": "text-3xl",
    },
    color: {
      neutral: "text-neutral-600",
      darkNeutral: "text-neutral-700",
      brandLightGreen: "text-brand-light-green",
      white: "text-neutral-50",
    },
    fontStyle: {
      normal: "font-normal",
      bold: "font-bold",
    },
  },
  defaultVariants: { size: "lg", color: "neutral", fontStyle: "normal" },
});

type BodyVariants = VariantProps<typeof body>;

interface Props {
  size?: BodyVariants["size"];
  className?: string;
  fontStyle?: BodyVariants["fontStyle"];
  color?: BodyVariants["color"];
  tag?: ValidTag; // "as" prop name breaks the Props interface recognition (https://github.com/withastro/compiler/issues/927)
}

const { size, className, fontStyle, color, tag = "p" } = Astro.props;

const classes = [body({ size, fontStyle, color }), className].join(" ");

const Tag = tag;
---

<Tag class={classes}>
  <slot />
</Tag>
