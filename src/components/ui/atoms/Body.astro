---
import { cva, type VariantProps } from "class-variance-authority";

const { size, className, fontStyle, color } = Astro.props;

const body = cva(["text-pretty", className], {
  variants: {
    // todo: refactor this when all currently used sizes are defined
    size: {
      small: "text-md sm:text-lg",
      lg: "text-lg sm:text-xl",
      "6xl": "text-6xl",
      "3xl": "text-3xl",
    },
    color: {
      neutral: "text-neutral-600",
      darkNeutral: "text-neutral-700",
      brandLightGreen: "text-brand-light-green",
    },
    fontStyle: {
      normal: "font-normal",
      bold: "font-bold",
    },
  },
  defaultVariants: {
    size: "lg",
    color: "neutral",
    fontStyle: "normal",
  },
});

type BodyVariants = VariantProps<typeof body>; // todo: move this up?

interface Props {
  size?: BodyVariants["size"];
  className?: string;
  fontStyle?: BodyVariants["fontStyle"];
  color?: BodyVariants["color"];
}

const classes = body({ size, fontStyle, color });
---

<p class={classes}>
  <slot />
</p>
