---
import { cva, cx, type VariantProps } from "class-variance-authority";
import type { HTMLTag } from "astro/types";
import { fontWeightVariants } from "@components/ui/props/typography";

const body = cva(["text-pretty"], {
  variants: {
    size: {
      xsmall: "text-sm",
      small: "text-md sm:text-lg",
      lg: "text-lg sm:text-xl",
      "6xl": "text-6xl",
      "3xl": "text-3xl",
    },
    color: {
      neutral: "text-neutral-600",
      darkNeutral: "text-neutral-700",
      brandLightGreen: "text-brand-light-green",
      white: "text-neutral-50",
    },
    fontStyle: fontWeightVariants,
  },
  defaultVariants: { size: "lg", color: "neutral", fontStyle: "normal" },
});

type BodyVariants = VariantProps<typeof body>;

interface Props extends BodyVariants {
  className?: string;
  renderAs?: HTMLTag;
}

const { size, className, fontStyle, color, renderAs } = Astro.props;

const classes = cx(body({ size, fontStyle, color }), className);

const Tag: HTMLTag = renderAs ?? "p";
---

<Tag class={classes}>
  <slot />
</Tag>
