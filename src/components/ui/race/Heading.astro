---
interface Props {
  label: string;
  id?: string;
  tag?: string;
}

type ValidTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

const VALID_TAGS = ["h1", "h2", "h3", "h4", "h5", "h6"];

function isValidTag(string: string | undefined): string is ValidTag {
  if (!string) return false;
  return VALID_TAGS.includes(string);
}

const { label, id, tag } = Astro.props;

const Tag: ValidTag = isValidTag(tag) ? tag : "h2";

const headingId =
  id ?? label.toLocaleLowerCase().replaceAll(" ", "-").replaceAll("é", "e").replaceAll("è", "e");
---

<Tag id={headingId}>{label}</Tag>
