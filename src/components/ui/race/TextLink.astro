---
import Body from "@/components/ui/atoms/Body.astro";
import Icon from "@/components/ui/icons/Icon.astro";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<Body
  size="small"
  fontStyle="bold"
  color="darkNeutral"
  className="hover:underline hover:underline-offset-2"
>
  <a href={href} target="_blank" class="link__text">
    <slot />
    <Icon name="openInNew" />
  </a>
</Body>
