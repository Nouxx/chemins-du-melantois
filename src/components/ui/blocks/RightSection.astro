---
import type { ImageMetadata } from "astro";
import PrimaryCTA from "@/components/functional/PrimaryCTA.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import Body from "@/components/ui/atoms/Body.astro";
import List from "@/components/ui/molecules/List.astro";
import ListItem from "@/components/ui/molecules/ListItem.astro";
import ImageWrapper from "@/components/ui/atoms/ImageWrapper.astro";

export interface ButtonLink {
  title: string;
  url: string;
  openInNewTab?: boolean;
}

interface Props {
  title: string;
  subTitle: string;
  image: ImageMetadata;
  imageAlt: string;
  imageLoading?: HTMLImageElement["loading"];
  list?: string[];
  links?: ButtonLink[];
}

const { title, subTitle, image, imageAlt, imageLoading, list, links } =
  Astro.props;
---

<div class="flex flex-col gap-8 md:flex-row">
  <div class="flex max-w-full flex-col gap-4 md:max-w-1/2">
    <Heading tag="h1">
      {title}
    </Heading>

    <Body>
      {subTitle}
    </Body>

    {
      list && list.length > 0 && (
        <List>
          {list.map((item) => (
            <ListItem>{item}</ListItem>
          ))}
        </List>
      )
    }

    {
      links && links.length > 0 && (
        <div class="flex flex-row gap-4">
          {links.map((link) => (
            <PrimaryCTA
              label={link.title}
              url={link.url}
              openInNewTab={link.openInNewTab}
            />
          ))}
        </div>
      )
    }
  </div>

  <div class="max-w-full md:max-w-1/2">
    <ImageWrapper
      image={image}
      imageAlt={imageAlt}
      imageLoading={imageLoading}
      sizes="(max-width: 1023px) 100vw, (max-width: 1536px) 50vw, 672px"
      rounded
    />
  </div>
</div>
