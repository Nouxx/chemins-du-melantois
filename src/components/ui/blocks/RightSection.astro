---
import { Image } from "astro:assets";
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import type { ImageMetadata } from "astro";

const { title, subTitle, image, imageAlt, list, links } = Astro.props;

export interface ButtonLink {
  title: string;
  url: string;
  openInNewTab?: boolean;
}

interface Props {
  title: string;
  subTitle: string;
  image: ImageMetadata;
  imageAlt: string;
  list?: string[];
  links?: ButtonLink[];
}
---

<section
  class="mx-auto max-w-[85rem] items-center gap-16 px-4 py-10 sm:px-6 lg:grid lg:grid-cols-2 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div class="mb-4 lg:mb-0">
    <h2
      class="mb-4 text-4xl font-extrabold tracking-tight text-balance text-neutral-800 dark:text-neutral-200"
    >
      {title}
    </h2>

    <p
      class="mb-4 max-w-prose font-normal text-pretty text-neutral-600 sm:text-lg dark:text-neutral-400"
    >
      {subTitle}
    </p>

    <ul
      class="mb-4 max-w-prose font-normal text-pretty text-neutral-600 sm:text-lg dark:text-neutral-400"
    >
      {
        list &&
          list.map((item) => <li class="mb-2 list-inside list-disc">{item}</li>)
      }
    </ul>

    {
      links && links.length > 0 && (
        <div class="flex flex-row gap-2">
          {links.map((link) => (
            <PrimaryCTA
              title={link.title}
              url={link.url}
              openInNewTab={link.openInNewTab}
            />
          ))}
        </div>
      )
    }
  </div>

  <div class="image__placeholder">
    <Image
      class="w-full rounded-lg"
      src={image}
      alt={imageAlt}
      format={"avif"}
      sizes="(max-width: 1023px) 100vw, (max-width: 1536px) 50vw, 672px"
    />
  </div>
</section>

<style>
  /* todo: make this generic */
  .image__placeholder {
    background-color: var(--color-gray-100);
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
    border-radius: 0.5rem;
  }
</style>
