---
interface Props {
  url: string;
  name: string;
  isCurrent: boolean;
}

const { url, name, isCurrent } = Astro.props;

const baseClass =
  "rounded-lg text-base font-medium ring-zinc-500 outline-hidden focus-visible:ring-3 md:py-3 md:text-sm 2xl:text-base dark:ring-zinc-200 dark:hover:text-neutral-500 dark:focus:outline-hidden";

const currentClass = isCurrent
  ? "text-brand-light-green underline underline-offset-3"
  : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-500 dark:hover:text-neutral-500";
---

<a
  href={url}
  data-astro-prefetch
  class={`${baseClass} ${currentClass}`}
  aria-current={isCurrent ? "page" : undefined}
>
  {name}
</a>
